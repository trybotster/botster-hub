{
  "name": "dogfood.synthetic-plugin",
  "version": "1.0.0",
  "kind": "plugin",
  "botster": ">=0.1.0",
  "source": { "type": "path", "path": "." },
  "capabilities": [
    { "surface": "mcp" },
    { "surface": "timers", "scope": "callbacks" }
  ],
  "entrypoints": [
    { "runtime": "lua", "path": "plugin.lua", "bootstrap": false }
  ],
  "configuration": {
    "fields": [
      {
        "key": "endpoint",
        "type": "url",
        "label": "Webhook endpoint",
        "default": { "type": "url", "value": "https://example.invalid/hook" }
      },
      {
        "key": "mode",
        "type": "select",
        "label": "Mode",
        "default": { "type": "select", "value": "read" },
        "options": [
          { "value": "read", "label": "Read" },
          { "value": "write", "label": "Write" }
        ]
      },
      {
        "key": "api_token",
        "type": "secret",
        "label": "API token",
        "default": { "type": "secret", "state": "unset" }
      }
    ]
  }
}
