{
  "name": "project-pipelines",
  "version": "1.0.0",
  "kind": "plugin",
  "botster": ">=0.1.0",
  "source": { "type": "path", "path": "." },
  "capabilities": [
    { "surface": "mcp" },
    { "surface": "plugin_db", "scope": "project-pipelines" },
    { "surface": "session_actions", "scope": "session_template_spawn" },
    { "surface": "surfaces" }
  ],
  "entrypoints": [
    { "runtime": "lua", "path": "plugin.lua", "bootstrap": false }
  ],
  "surfaces": [
    {
      "id": "project-pipelines.create-ticket",
      "kind": "app",
      "title": "Create Project Pipelines ticket",
      "description": "Example package surface for the reusable Project Pipelines conformance flow.",
      "supports": ["render", "action"]
    }
  ],
  "session_templates": [
    {
      "id": "agent-step",
      "command": "bin/agent-step.sh",
      "context": ["prompt", "ticket_id", "worktree_path", "metadata.request_id", "metadata.agent_name", "metadata.worktree_id"]
    }
  ],
  "dependencies": [
    {
      "id": "github-provider",
      "package": "github-provider",
      "kind": "optional",
      "feature": "github_pr_lifecycle",
      "requirements": [
        { "type": "provider", "provider": "github-provider" }
      ]
    }
  ],
  "features": [
    {
      "id": "local_pipelines",
      "label": "Local pipelines"
    },
    {
      "id": "github_pr_lifecycle",
      "label": "GitHub PR lifecycle",
      "dependencies": ["github-provider"],
      "requirements": [
        { "type": "config", "key": "github_app_id" },
        { "type": "auth", "key": "github_token" }
      ]
    }
  ],
  "configuration": {
    "fields": [
      {
        "key": "operator_endpoint",
        "type": "url",
        "label": "Operator endpoint",
        "default": { "type": "url", "value": "https://example.invalid/project-pipelines" }
      },
      {
        "key": "pipeline_mode",
        "type": "select",
        "label": "Pipeline mode",
        "default": { "type": "select", "value": "local" },
        "options": [
          { "value": "local", "label": "Local" },
          { "value": "github", "label": "GitHub" }
        ]
      },
      {
        "key": "api_token",
        "type": "secret",
        "label": "API token",
        "default": { "type": "secret", "state": "unset" }
      }
    ]
  }
}
