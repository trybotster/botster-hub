// The Zig packages that libghostty-vt's build needs (botster-core's botster-terminal-ghostty, `build_data.rs`
// ZIG_PACKAGES), as data: ci/remote/fetch-public.sh runs `zig build --fetch` on this project to fill the package store,
// with no read of botster-core's checkout. `cargo xtask zig-packages` fails when this list differs from the one that
// botster-core's pin in Cargo.lock names. Zig checks each download against its hash, so a wrong URL fails the fetch.
.{
    .name = .zig_prefetch,
    .version = "0.0.0",
    .fingerprint = 0xcbb4cccc1bb2737b,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .aro = .{
            .url = "https://github.com/vancluever/arocc/archive/f97cdfc3779aec4b242299e2fc9a1c828c3547c6.tar.gz",
