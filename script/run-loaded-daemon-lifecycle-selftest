#!/usr/bin/env bash
set -uo pipefail

readonly RUNNER=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/run-loaded-daemon-lifecycle
readonly PROCESS_CENSUS=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/process-census
SELFTEST_DIR=$(mktemp -d)
FIXTURE_PID=
DECOY_PID=
ESCAPED_PID=
ZOMBIE_PARENT_PID=
ZOMBIE_PID=
BASELINE_ROLE_PARENT_PID=
BASELINE_ROLE_ZOMBIE_PID=
NEW_ROLE_PARENT_PID=
NEW_ROLE_ZOMBIE_PID=
STARTED_ROLE_PARENT_PID=
STARTED_ROLE_ZOMBIE_PID=

cleanup_selftest() {
  if [[ -n "$FIXTURE_PID" ]]; then
    kill -TERM -- "-$FIXTURE_PID" 2>/dev/null || true
  fi
  if [[ -n "$DECOY_PID" ]]; then
    kill -TERM -- "-$DECOY_PID" 2>/dev/null || true
  fi
  if [[ -n "$ESCAPED_PID" ]]; then
    kill -TERM -- "-$ESCAPED_PID" 2>/dev/null || true
  fi
  if [[ -n "$ZOMBIE_PARENT_PID" ]]; then
    kill -TERM -- "-$ZOMBIE_PARENT_PID" 2>/dev/null || true
  fi
  if [[ -n "$BASELINE_ROLE_PARENT_PID" ]]; then
    kill -TERM -- "-$BASELINE_ROLE_PARENT_PID" 2>/dev/null || true
  fi
  if [[ -n "$NEW_ROLE_PARENT_PID" ]]; then
    kill -TERM -- "-$NEW_ROLE_PARENT_PID" 2>/dev/null || true
  fi
  wait "${FIXTURE_PID:-}" 2>/dev/null || true
  wait "${DECOY_PID:-}" 2>/dev/null || true
  wait "${ESCAPED_PID:-}" 2>/dev/null || true
  wait "${ZOMBIE_PARENT_PID:-}" 2>/dev/null || true
  wait "${BASELINE_ROLE_PARENT_PID:-}" 2>/dev/null || true
  wait "${NEW_ROLE_PARENT_PID:-}" 2>/dev/null || true
  rm -rf "$SELFTEST_DIR"
}
trap cleanup_selftest EXIT INT TERM HUP

fail() {
  printf 'not ok - %s\n' "$*" >&2
  exit 1
}

pass() {
  printf 'ok - %s\n' "$*"
}

start_role_zombie() {
  local pid_file=$1
  local comm=$2

  setsid python3 -c '
import ctypes
import os
import sys
import time

if ctypes.CDLL(None).prctl(15, sys.argv[2].encode(), 0, 0, 0) != 0:
    raise OSError(ctypes.get_errno(), "prctl(PR_SET_NAME) failed")
child = os.fork()
if child == 0:
    os.setpgid(0, 0)
    os._exit(0)
with open(sys.argv[1], "w", encoding="utf-8") as output:
    output.write(f"{child}\n")
time.sleep(300)
' "$pid_file" "$comm" &
  STARTED_ROLE_PARENT_PID=$!

  for _ in {1..100}; do
    [[ -s "$pid_file" ]] && break
    sleep 0.05
  done
  [[ -s "$pid_file" ]] \
    || fail "$comm role zombie fixture did not publish its child pid"
  STARTED_ROLE_ZOMBIE_PID=$(cat "$pid_file")
}

source "$RUNNER" --artifact-dir "$SELFTEST_DIR/source-must-not-run"
[[ ! -e "$SELFTEST_DIR/source-must-not-run" ]] || fail "sourcing executed runner main"
pass "runner sources without CLI or campaign side effects"

"$PROCESS_CENSUS" --self-test || fail "process census positive control failed"
pass "process census observes executable-provenance survivors"

timeout_dir="$SELFTEST_DIR/event-plane-timeout"
mkdir -p "$timeout_dir"
BOTSTER_LOADED_RUN_TIMEOUT_SECONDS=900 BOTSTER_EVENT_PLANE_PHASE=calibration "$RUNNER" \
  --validate-only \
  --artifact-dir "$timeout_dir" \
  --subject-sha 0123456789abcdef0123456789abcdef01234567 \
  --test-target event-plane-saturation \
  --repetitions 1 \
  --stress-profile residual-tail \
  || fail "event-plane-saturation validate-only failed under a 900s env"
grep -q '^run_timeout_seconds=3600$' "$timeout_dir/metadata.txt" \
  || fail "event-plane-saturation must resolve 3600s even when BOTSTER_LOADED_RUN_TIMEOUT_SECONDS=900"
grep -q '^run_timeout_max=3600$' "$timeout_dir/metadata.txt" \
  || fail "event-plane-saturation must advertise run_timeout_max=3600"
grep -q '^event_plane_phase=calibration$' "$timeout_dir/metadata.txt" \
  || fail "event-plane-saturation must record BOTSTER_EVENT_PLANE_PHASE"
pass "event-plane-saturation run timeout is 3600s when the workflow default is 900s"

missing_phase_dir="$SELFTEST_DIR/event-plane-missing-phase"
mkdir -p "$missing_phase_dir"
if BOTSTER_LOADED_RUN_TIMEOUT_SECONDS=3600 env -u BOTSTER_EVENT_PLANE_PHASE "$RUNNER" \
  --validate-only \
  --artifact-dir "$missing_phase_dir" \
  --subject-sha 0123456789abcdef0123456789abcdef01234567 \
  --test-target event-plane-saturation \
  --repetitions 1 \
  --stress-profile residual-tail; then
  fail "event-plane-saturation validate-only must fail without BOTSTER_EVENT_PLANE_PHASE"
fi
pass "event-plane-saturation validate-only requires an explicit phase"

acceptance_dir="$SELFTEST_DIR/event-plane-acceptance-phase"
mkdir -p "$acceptance_dir"
BOTSTER_EVENT_PLANE_PHASE=acceptance \
  BOTSTER_EVENT_PLANE_CALIBRATION_COMMIT=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
  "$RUNNER" \
  --validate-only \
  --artifact-dir "$acceptance_dir" \
  --subject-sha 0123456789abcdef0123456789abcdef01234567 \
  --test-target event-plane-saturation \
  --repetitions 1 \
  --stress-profile residual-tail \
  || fail "event-plane-saturation acceptance validate-only failed"
grep -q '^event_plane_phase=acceptance$' "$acceptance_dir/metadata.txt" \
  || fail "event-plane-saturation must record acceptance phase"
grep -q '^event_plane_calibration_commit=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa$' "$acceptance_dir/metadata.txt" \
  || fail "acceptance must record the selected calibration commit"
pass "event-plane-saturation acceptance phase is a validated workflow input"

missing_commit_dir="$SELFTEST_DIR/event-plane-missing-calibration-commit"
mkdir -p "$missing_commit_dir"
if BOTSTER_EVENT_PLANE_PHASE=acceptance env -u BOTSTER_EVENT_PLANE_CALIBRATION_COMMIT "$RUNNER" \
  --validate-only \
  --artifact-dir "$missing_commit_dir" \
  --subject-sha 0123456789abcdef0123456789abcdef01234567 \
  --test-target event-plane-saturation \
  --repetitions 1 \
  --stress-profile residual-tail; then
  fail "acceptance validate-only must fail without BOTSTER_EVENT_PLANE_CALIBRATION_COMMIT"
fi
pass "acceptance validate-only requires the calibration dataset commit"

command -v python3 >/dev/null 2>&1 \
  || fail "missing required self-test command: python3"

ARTIFACT_DIR="$SELFTEST_DIR/artifacts"
mkdir -p "$ARTIFACT_DIR"
CLEANUP_LOG="$ARTIFACT_DIR/cleanup.log"
OWNERSHIP_FILE="$ARTIFACT_DIR/owned-pgids.tsv"
ACTIVE_OWNERSHIP_FILE="$ARTIFACT_DIR/active-pgids.tsv"
SESSION_OWNERSHIP_FILE="$ARTIFACT_DIR/owned-sessions.tsv"
ACTIVE_SESSION_OWNERSHIP_FILE="$ARTIFACT_DIR/active-sessions.tsv"
TOKEN_OWNERSHIP_FILE="$ARTIFACT_DIR/owned-run-tokens.tsv"
ACTIVE_TOKEN_OWNERSHIP_FILE="$ARTIFACT_DIR/active-run-tokens.tsv"
touch "$CLEANUP_LOG" "$OWNERSHIP_FILE" "$ACTIVE_OWNERSHIP_FILE" \
  "$SESSION_OWNERSHIP_FILE" "$ACTIVE_SESSION_OWNERSHIP_FILE" \
  "$TOKEN_OWNERSHIP_FILE" "$ACTIVE_TOKEN_OWNERSHIP_FILE"

scanner_baseline="$ARTIFACT_DIR/scanner-error-baseline.tsv"
: > "$scanner_baseline"
saved_all_process_rows=$(declare -f all_process_rows)
all_process_rows() {
  return 73
}
capture_settled_zombie_survivors "" "$scanner_baseline" \
  "$ARTIFACT_DIR/scanner-error-evidence.tsv"
scanner_status=$?
eval "$saved_all_process_rows"
((scanner_status == 2)) \
  || fail "zombie scanner failure was not propagated; status=$scanner_status"
pass "zombie census fails closed when its process scanner fails"

start_owned_group bash -c 'exit 0'
finished_pid=$STARTED_PID
wait "$finished_pid"
no_survivor_evidence="$ARTIFACT_DIR/no-survivors.tsv"
capture_session_survivors selftest "$finished_pid" "$no_survivor_evidence" \
  || fail "finished session reported a survivor"
[[ $(wc -l < "$no_survivor_evidence") -eq 1 ]] \
  || fail "no-survivor evidence should contain only its header"
pass "no-survivor session is green"

if [[ "$(runner_platform)" == Linux ]]; then
  zombie_pid_file="$ARTIFACT_DIR/zombie.pid"
  start_owned_group python3 -c '
import os
import sys
import time

child = os.fork()
if child == 0:
    os.setpgid(0, 0)
    os._exit(0)
with open(sys.argv[1], "w", encoding="utf-8") as output:
    output.write(f"{child}\n")
time.sleep(300)
' "$zombie_pid_file"
  ZOMBIE_PARENT_PID=$STARTED_PID

for _ in {1..100}; do
  [[ -s "$zombie_pid_file" ]] && break
  sleep 0.05
done
[[ -s "$zombie_pid_file" ]] || fail "zombie fixture did not publish its child pid"
ZOMBIE_PID=$(cat "$zombie_pid_file")
zombie_ready=0
for _ in {1..100}; do
  if session_zombie_rows "$ZOMBIE_PARENT_PID" | awk -v pid="$ZOMBIE_PID" '$1 == pid { found=1 } END { exit !found }'; then
    zombie_ready=1
    break
  fi
  sleep 0.05
done
((zombie_ready == 1)) || fail "unreaped child was not observed as a zombie"
if group_is_alive "$ZOMBIE_PID"; then
  fail "zombie-only process group was classified live"
fi
if direct_child_is_running "$ZOMBIE_PID"; then
  fail "zombie child was classified running"
fi
zombie_baseline="$ARTIFACT_DIR/zombie-baseline.tsv"
: > "$zombie_baseline"
zombie_evidence="$ARTIFACT_DIR/zombie-survivors.tsv"
if capture_settled_zombie_survivors "$ZOMBIE_PARENT_PID" "$zombie_baseline" "$zombie_evidence"; then
  fail "zombie that survived the settle gate was classified clean"
fi
grep -q $'^recorded-session\t' "$zombie_evidence" \
  || fail "zombie evidence omitted the recorded-session row"
pass "zombie survives the settle gate without entering live cleanup predicates"

kill -TERM -- "-$ZOMBIE_PARENT_PID" 2>/dev/null || true
wait "$ZOMBIE_PARENT_PID" 2>/dev/null || true
ZOMBIE_PARENT_PID=
for _ in {1..100}; do
  kill -0 "$ZOMBIE_PID" 2>/dev/null || break
  sleep 0.05
done
kill -0 "$ZOMBIE_PID" 2>/dev/null && fail "zombie fixture remained after its parent exited"
capture_settled_zombie_survivors "" "$zombie_baseline" "$ARTIFACT_DIR/reaped-zombie.tsv" \
  || fail "reaped zombie row remained in settled evidence"
  ZOMBIE_PID=
  pass "reaped zombie disappears from the settled evidence gate"
else
  pass "numeric-session zombie fixture is Linux-only"
fi

if [[ "$(runner_platform)" == Linux ]]; then
  baseline_role_pid_file="$ARTIFACT_DIR/baseline-role-zombie.pid"
  start_role_zombie "$baseline_role_pid_file" botster-hub
  BASELINE_ROLE_PARENT_PID=$STARTED_ROLE_PARENT_PID
  BASELINE_ROLE_ZOMBIE_PID=$STARTED_ROLE_ZOMBIE_PID
  baseline_role_ready=0
  for _ in {1..100}; do
    if botster_role_zombie_rows \
      | awk -v pid="$BASELINE_ROLE_ZOMBIE_PID" '$1 == pid { found=1 } END { exit !found }'; then
      baseline_role_ready=1
      break
    fi
    sleep 0.05
  done
  ((baseline_role_ready == 1)) \
    || fail "botster-hub role zombie was not observed"

  role_zombie_baseline="$ARTIFACT_DIR/role-zombie-baseline.tsv"
  botster_role_zombie_rows > "$role_zombie_baseline" \
    || fail "role zombie baseline census failed"
  awk -v pid="$BASELINE_ROLE_ZOMBIE_PID" '$1 == pid { found=1 } END { exit !found }' \
    "$role_zombie_baseline" \
    || fail "role zombie baseline omitted the pre-existing botster-hub zombie"

  new_role_pid_file="$ARTIFACT_DIR/new-role-zombie.pid"
  start_role_zombie "$new_role_pid_file" botster-session
  NEW_ROLE_PARENT_PID=$STARTED_ROLE_PARENT_PID
  NEW_ROLE_ZOMBIE_PID=$STARTED_ROLE_ZOMBIE_PID
  new_role_ready=0
  for _ in {1..100}; do
    if session_zombie_rows "$NEW_ROLE_PARENT_PID" \
      | awk -v pid="$NEW_ROLE_ZOMBIE_PID" '$1 == pid { found=1 } END { exit !found }'; then
      new_role_ready=1
      break
    fi
    sleep 0.05
  done
  ((new_role_ready == 1)) \
    || fail "truncated session-worker role zombie was not observed"

  role_zombie_evidence="$ARTIFACT_DIR/role-zombie-survivors.tsv"
  capture_settled_zombie_survivors "$NEW_ROLE_PARENT_PID" \
    "$role_zombie_baseline" "$role_zombie_evidence"
  role_zombie_status=$?
  ((role_zombie_status == 1)) \
    || fail "new role zombie did not fail settled evidence; status=$role_zombie_status"
  awk -F '\t' -v pid="$NEW_ROLE_ZOMBIE_PID" \
    '$1 == "new-role" && $2 == pid { found=1 } END { exit !found }' \
    "$role_zombie_evidence" \
    || fail "new truncated session-worker zombie omitted from new-role evidence"
  if awk -F '\t' -v pid="$BASELINE_ROLE_ZOMBIE_PID" \
    '$2 == pid { found=1 } END { exit !found }' "$role_zombie_evidence"; then
    fail "pre-existing botster-hub role zombie was not subtracted by baseline"
  fi
  pass "cross-session role census reports new zombies and subtracts its baseline"

  kill -TERM -- "-$NEW_ROLE_PARENT_PID" 2>/dev/null || true
  wait "$NEW_ROLE_PARENT_PID" 2>/dev/null || true
  NEW_ROLE_PARENT_PID=
  kill -TERM -- "-$BASELINE_ROLE_PARENT_PID" 2>/dev/null || true
  wait "$BASELINE_ROLE_PARENT_PID" 2>/dev/null || true
  BASELINE_ROLE_PARENT_PID=
  for _ in {1..100}; do
    if ! kill -0 "$NEW_ROLE_ZOMBIE_PID" 2>/dev/null \
      && ! kill -0 "$BASELINE_ROLE_ZOMBIE_PID" 2>/dev/null; then
      break
    fi
    sleep 0.05
  done
  kill -0 "$NEW_ROLE_ZOMBIE_PID" 2>/dev/null \
    && fail "new role zombie remained after parent exit"
  kill -0 "$BASELINE_ROLE_ZOMBIE_PID" 2>/dev/null \
    && fail "baseline role zombie remained after parent exit"
  capture_settled_zombie_survivors "" "$role_zombie_baseline" \
    "$ARTIFACT_DIR/reaped-role-zombies.tsv" \
    || fail "reaped role zombies remained in settled evidence"
  NEW_ROLE_ZOMBIE_PID=
  BASELINE_ROLE_ZOMBIE_PID=
  pass "reaped cross-session role zombies disappear from settled evidence"
fi

if [[ "$(runner_platform)" == Linux ]]; then
escaped_token="botster-loaded-selftest-escaped-$$"
escaped_pid_file="$ARTIFACT_DIR/escaped.pid"
BOTSTER_LOADED_RUN_TOKEN="$escaped_token" setsid bash -c '
  setsid sleep 300 </dev/null >/dev/null 2>&1 &
  printf "%s\n" "$!" > "$1"
' fixture "$escaped_pid_file" &
escaped_parent_pid=$!
wait "$escaped_parent_pid"
ESCAPED_PID=$(cat "$escaped_pid_file")

escaped_ready=0
for _ in {1..100}; do
  if [[ -n "$(run_token_process_rows "$escaped_token")" ]]; then
    escaped_ready=1
    break
  fi
  sleep 0.05
done
((escaped_ready == 1)) || fail "setsid child that escaped its parent session was not found"
escaped_sid=$(ps -o sid= -p "$ESCAPED_PID" | tr -d '[:space:]')
[[ "$escaped_sid" == "$ESCAPED_PID" ]] || fail "escaped fixture did not enter its own session"

record_run_token selftest "$escaped_token" || fail "record escaped run token"
escaped_evidence="$ARTIFACT_DIR/escaped-owned-survivors.tsv"
if capture_run_token_survivors selftest "$escaped_token" "$escaped_evidence"; then
  fail "setsid child outside its parent session was classified clean"
fi
if verify_and_cleanup_run_token selftest "$escaped_token" "$escaped_evidence"; then
  fail "escaped setsid survivor did not produce a nonzero leak verdict"
fi
[[ -z "$(run_token_process_rows "$escaped_token")" ]] \
  || fail "escaped setsid survivor remained after exact token cleanup"
ESCAPED_PID=
pass "run-token ownership detects and cleans a child that escapes into its own session"

setsid sleep 300 &
DECOY_PID=$!

setsid bash -c '
  set -m
  trap "exit 0" TERM INT HUP
  bash -c '\''
    trap "exit 0" TERM INT HUP
    for ((worker = 1; worker <= 85; worker++)); do
      sleep 300 &
    done
    wait
  '\'' &
  wait
' &
FIXTURE_PID=$!

fixture_ready=0
for _ in {1..100}; do
  fixture_rows=$(session_process_rows "$FIXTURE_PID")
  fixture_count=$(printf '%s\n' "$fixture_rows" | awk 'NF { count++ } END { print count + 0 }')
  nested_pgid=$(printf '%s\n' "$fixture_rows" \
    | awk -F '\t' -v sid="$FIXTURE_PID" '$3 != sid { print $3; exit }')
  if ((fixture_count > SURVIVOR_EVIDENCE_LIMIT)) && [[ -n "$nested_pgid" ]]; then
    fixture_ready=1
    break
  fi
  sleep 0.05
done
((fixture_ready == 1)) || fail "nested child process group fixture did not become ready"
pass "nested child process group is visible inside the owned session"

record_session selftest "$FIXTURE_PID" || fail "record fixture session"
[[ "$RECORDED_SID" == "$FIXTURE_PID" ]] || fail "recorded SID differs from fixture leader"

survivor_evidence="$ARTIFACT_DIR/session-survivors.tsv"
if capture_session_survivors selftest "$FIXTURE_PID" "$survivor_evidence"; then
  fail "live fixture session was classified clean"
fi
grep -q $'^truncated\t' "$survivor_evidence" || fail "bounded evidence lacks truncation marker"
evidence_lines=$(wc -l < "$survivor_evidence")
((evidence_lines <= SURVIVOR_EVIDENCE_LIMIT + 2)) \
  || fail "survivor evidence exceeded its bound"
pass "survivor evidence is bounded"

if verify_and_cleanup_session selftest "$FIXTURE_PID" "$FIXTURE_PID" "$survivor_evidence"; then
  fail "detected survivor did not produce a nonzero leak verdict"
fi
pass "detected survivor produces a nonzero verdict"

wait "$FIXTURE_PID" 2>/dev/null || true
FIXTURE_PID=
[[ -z "$(session_process_rows "$RECORDED_SID")" ]] || fail "owned session survived cleanup"
kill -0 "$DECOY_PID" 2>/dev/null || fail "cleanup killed a process outside the owned session"
pass "cleanup removes only the owned session"

cleanup_session selftest "$RECORDED_SID" "$RECORDED_SID" \
  || fail "second cleanup was not idempotent"
kill -0 "$DECOY_PID" 2>/dev/null || fail "idempotent cleanup killed the decoy"
pass "second cleanup is idempotent"
else
  pass "setsid escape and numeric-session cleanup fixtures are Linux-only"
fi

printf 'loaded daemon lifecycle selftest passed\n'
