#!/bin/sh
set -eu

usage() {
  cat >&2 <<'USAGE'
usage: script/tag-ui-contract [--dry-run] [--verify]

Create or verify the annotated Hub tag for the Rust UI contract:

  botster-ui-contract-v<crate-version>

The tag is the consumer identity. This script does not publish crates.io
and does not change npm. Use --dry-run to check preconditions without
creating a tag. Use --verify to check an existing local or origin tag.
USAGE
  exit 64
}

mode=create
case "${1-}" in
  "") ;;
  --dry-run) mode=dry-run ;;
  --verify) mode=verify ;;
  *) usage ;;
esac
[ "$#" -le 1 ] || usage

repo_dir=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd -P)
crate_manifest=$repo_dir/crates/botster-ui-contract/Cargo.toml

crate_version() {
  awk '
    $0 == "[package]" { in_pkg = 1; next }
    in_pkg && /^\[/ { exit }
    in_pkg && $1 == "version" {
      gsub(/"/, "", $3)
      print $3
      exit
    }
  ' "$crate_manifest"
}

require_clean_worktree() {
  changes=$(git -C "$repo_dir" status --porcelain)
  [ -z "$changes" ] || {
    printf 'Refusing to tag from a dirty worktree:\n%s\n' "$changes" >&2
    exit 65
  }
}

tagged_crate_version() {
  tag_name=$1
  git -C "$repo_dir" show "${tag_name}:crates/botster-ui-contract/Cargo.toml" | awk '
    $0 == "[package]" { in_pkg = 1; next }
    in_pkg && /^\[/ { exit }
    in_pkg && $1 == "version" {
      gsub(/"/, "", $3)
      print $3
      exit
    }
  '
}

log() {
  printf '==> %s\n' "$*"
}

for command_name in git; do
  command -v "$command_name" >/dev/null 2>&1 || {
    printf 'Required command is unavailable: %s\n' "$command_name" >&2
    exit 69
  }
done

version=$(crate_version)
[ -n "$version" ] || {
  printf 'Could not read version from %s\n' "$crate_manifest" >&2
  exit 66
}

tag_name=botster-ui-contract-v${version}
head_sha=$(git -C "$repo_dir" rev-parse HEAD)

log "Crate version ${version}; tag ${tag_name}; HEAD ${head_sha}"

if [ "$mode" = verify ]; then
  if git -C "$repo_dir" rev-parse -q --verify "refs/tags/${tag_name}" >/dev/null; then
    tag_sha=$(git -C "$repo_dir" rev-parse "${tag_name}^{commit}")
  else
    git -C "$repo_dir" fetch --tags origin "${tag_name}"
    tag_sha=$(git -C "$repo_dir" rev-parse "${tag_name}^{commit}")
  fi
  tagged_version=$(tagged_crate_version "$tag_name")
  [ "$tagged_version" = "$version" ] || {
    printf 'Tag %s crate version %s does not match working crate version %s\n' \
      "$tag_name" "$tagged_version" "$version" >&2
    exit 67
  }
  log "Verified ${tag_name} -> ${tag_sha} with crate version ${tagged_version}"
  exit 0
fi

require_clean_worktree

if git -C "$repo_dir" rev-parse -q --verify "refs/tags/${tag_name}" >/dev/null; then
  existing=$(git -C "$repo_dir" rev-parse "${tag_name}^{commit}")
  [ "$existing" = "$head_sha" ] || {
    printf 'Tag %s already points at %s, not HEAD %s\n' "$tag_name" "$existing" "$head_sha" >&2
    exit 67
  }
  log "${tag_name} already exists on HEAD; nothing to create"
  exit 0
fi

if [ "$mode" = dry-run ]; then
  log "Dry run: would create annotated tag ${tag_name} on ${head_sha}"
  exit 0
fi

git -C "$repo_dir" tag -a "$tag_name" -m "botster-ui-contract ${version}"
log "Created annotated tag ${tag_name} on ${head_sha}"
