#!/usr/bin/env bash
set -uo pipefail

readonly DEFAULT_RUN_TIMEOUT_SECONDS=900
readonly DEFAULT_CAMPAIGN_TIMEOUT_SECONDS=19800
readonly CLEANUP_GRACE_SECONDS=30
readonly SURVIVOR_EVIDENCE_LIMIT=80
readonly ZOMBIE_SETTLE_SECONDS=5
readonly PROCESS_CENSUS_HELPER="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/process-census"

MODE=run
SUBJECT_DIR=
ARTIFACT_DIR=
SUBJECT_SHA=
TEST_TARGET=
REPETITIONS=
STRESS_PROFILE=

LOAD_PID=
LOAD_PGID=
SAMPLER_PID=
SAMPLER_PGID=
TEST_PID=
TEST_PGID=
TEST_SID=
TEST_RUN_TOKEN=
RECORDED_PGID=
RECORDED_SID=
STARTED_PID=
FINALIZED=0
CLEANUP_LOG=
OWNERSHIP_FILE=
ACTIVE_OWNERSHIP_FILE=
SESSION_OWNERSHIP_FILE=
ACTIVE_SESSION_OWNERSHIP_FILE=
TOKEN_OWNERSHIP_FILE=
ACTIVE_TOKEN_OWNERSHIP_FILE=

usage() {
  cat <<'USAGE'
Usage:
  run-loaded-daemon-lifecycle --subject-dir DIR --artifact-dir DIR \
    --subject-sha SHA --test-target TARGET --repetitions COUNT \
    --stress-profile PROFILE
  run-loaded-daemon-lifecycle --validate-only --artifact-dir DIR \
    --subject-sha SHA --test-target TARGET --repetitions COUNT \
    --stress-profile PROFILE
  run-loaded-daemon-lifecycle --cleanup-only --artifact-dir DIR
USAGE
}

log() {
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" | tee -a "$ARTIFACT_DIR/harness.log"
}

cleanup_log() {
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" | tee -a "$CLEANUP_LOG"
}

validate_inputs() {
  local invalid=0

  if [[ ! "$SUBJECT_SHA" =~ ^[0-9a-f]{40}$ ]]; then
    log "invalid subject_sha: expected a lowercase 40-character commit SHA"
    invalid=1
  fi
  case "$TEST_TARGET" in
    lifecycle-suite|focused-metadata-owned-shutdown|focused-occupied-web-port|focused-session-entity-resize|focused-process-ownership|focused-connection-lifecycle|focused-plugin-resource-bounds|focused-stalled-attach|focused-fast-exit-attach-diagnostic|focused-oversized-webrtc|focused-cli-smoke|focused-operator-console|focused-lua-worker-suite|focused-lua-session-worker-callers|event-plane-saturation|full-suite-contention) ;;
    *) log "invalid test_target: $TEST_TARGET"; invalid=1 ;;
  esac
  if [[ ! "$REPETITIONS" =~ ^[0-9]+$ ]] || ((10#$REPETITIONS < 1 || 10#$REPETITIONS > 100)); then
    log "invalid repetitions: expected an integer from 1 through 100"
    invalid=1
  fi
  case "$STRESS_PROFILE" in
    residual-tail|moderate|none) ;;
    *) log "invalid stress_profile: $STRESS_PROFILE"; invalid=1 ;;
  esac
  if [[ "$TEST_TARGET" == focused-plugin-resource-bounds && "$STRESS_PROFILE" != none ]]; then
    log "focused-plugin-resource-bounds requires stress_profile=none"
    invalid=1
  fi
  if [[ "$TEST_TARGET" == event-plane-saturation && "$STRESS_PROFILE" != none ]]; then
    log "event-plane-saturation requires stress_profile=none"
    invalid=1
  fi
  EVENT_PLANE_PHASE=${BOTSTER_EVENT_PLANE_PHASE:-}
  if [[ "$TEST_TARGET" == event-plane-saturation ]]; then
    case "$EVENT_PLANE_PHASE" in
      calibration|acceptance) ;;
      *)
        log "event-plane-saturation requires BOTSTER_EVENT_PLANE_PHASE=calibration or acceptance"
        invalid=1
        ;;
    esac
    if [[ "$EVENT_PLANE_PHASE" == acceptance ]]; then
      if [[ ! "${BOTSTER_EVENT_PLANE_CALIBRATION_COMMIT:-}" =~ ^[0-9a-f]{40}$ ]]; then
        log "acceptance requires BOTSTER_EVENT_PLANE_CALIBRATION_COMMIT as a lowercase 40-character SHA"
        invalid=1
      fi
    fi
  fi

  resolve_run_timeout
  {
    printf 'validated_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'subject_sha=%s\n' "$SUBJECT_SHA"
    printf 'test_target=%s\n' "$TEST_TARGET"
    printf 'repetitions=%s\n' "$REPETITIONS"
    printf 'stress_profile=%s\n' "$STRESS_PROFILE"
    printf 'run_timeout_seconds=%s\n' "$RUN_TIMEOUT_SECONDS"
    printf 'run_timeout_max=%s\n' "$RUN_TIMEOUT_MAX"
    if [[ "$TEST_TARGET" == event-plane-saturation ]]; then
      printf 'event_plane_phase=%s\n' "$EVENT_PLANE_PHASE"
      if [[ -n "${BOTSTER_EVENT_PLANE_CALIBRATION_COMMIT:-}" ]]; then
        printf 'event_plane_calibration_commit=%s\n' "$BOTSTER_EVENT_PLANE_CALIBRATION_COMMIT"
      fi
    fi
  } >> "$ARTIFACT_DIR/metadata.txt"

  if ((invalid != 0)); then
    printf 'validation_status=invalid\n' >> "$ARTIFACT_DIR/metadata.txt"
    return 2
  fi
  printf 'validation_status=valid\n' >> "$ARTIFACT_DIR/metadata.txt"
}

# Event-plane saturation needs 2 * (30s warm-up + 600s window) plus fleet
# setup. The workflow default of 900 seconds must not win for that target.
resolve_run_timeout() {
  RUN_TIMEOUT_SECONDS=${BOTSTER_LOADED_RUN_TIMEOUT_SECONDS:-$DEFAULT_RUN_TIMEOUT_SECONDS}
  RUN_TIMEOUT_MAX=1800
  if [[ "$TEST_TARGET" == event-plane-saturation ]]; then
    RUN_TIMEOUT_MAX=3600
    if [[ -z "${BOTSTER_LOADED_RUN_TIMEOUT_SECONDS:-}" ]] \
      || ((10#$BOTSTER_LOADED_RUN_TIMEOUT_SECONDS < 3600)); then
      RUN_TIMEOUT_SECONDS=3600
    else
      RUN_TIMEOUT_SECONDS=$BOTSTER_LOADED_RUN_TIMEOUT_SECONDS
    fi
  fi
}

validate_linux_runner() {
  local command_name
  local invalid=0

  for command_name in awk bash free nproc ps setsid tee; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
      log "missing required Linux runner command: $command_name"
      invalid=1
    fi
  done
  if [[ ! -r /proc/loadavg ]]; then
    log "missing required Linux runner interface: /proc/loadavg"
    invalid=1
  fi
  ((invalid == 0))
}

runner_platform() {
  uname -s
}

validate_runner() {
  local command_name
  local invalid=0

  for command_name in awk bash ps tee; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
      log "missing required runner command: $command_name"
      invalid=1
    fi
  done
  case "$(runner_platform)" in
    Linux)
      validate_linux_runner || invalid=1
      ;;
    Darwin)
      for command_name in perl; do
        if ! command -v "$command_name" >/dev/null 2>&1; then
          log "missing required Darwin process-group launcher command: $command_name"
          invalid=1
        fi
      done
      if [[ "$STRESS_PROFILE" != none ]]; then
        log "Darwin campaigns require --stress-profile none"
        invalid=1
      fi
      ;;
    *)
      log "unsupported runner platform: $(runner_platform)"
      invalid=1
      ;;
  esac
  ((invalid == 0))
}

start_owned_group() {
  if [[ "$(runner_platform)" == Darwin ]]; then
    perl -MPOSIX -e 'POSIX::setsid() >= 0 or die "setsid: $!"; exec @ARGV or die "exec: $!"' \
      "$@" &
  else
    setsid "$@" &
  fi
  STARTED_PID=$!
}

runner_cpu_count() {
  if [[ "$(runner_platform)" == Darwin ]]; then
    sysctl -n hw.ncpu 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || printf '1\n'
  else
    nproc
  fi
}

group_is_alive() {
  local pgid=$1

  ps -eo pgid=,stat= \
    | awk -v pgid="$pgid" '$1 == pgid && $2 !~ /^Z/ { found=1 } END { exit !found }'
}

direct_child_is_running() {
  local pid=$1
  local state

  state=$(ps -o stat= -p "$pid" 2>/dev/null | tr -d '[:space:]')
  [[ -n "$state" && "$state" != Z* ]]
}

deactivate_group() {
  local pid=$1
  local pgid=$2
  local temporary_file="$ACTIVE_OWNERSHIP_FILE.tmp.$$"

  touch "$ACTIVE_OWNERSHIP_FILE"
  awk -F '\t' -v pid="$pid" -v pgid="$pgid" \
    '!(($2 == pid) && ($3 == pgid))' "$ACTIVE_OWNERSHIP_FILE" > "$temporary_file"
  mv "$temporary_file" "$ACTIVE_OWNERSHIP_FILE"
}

deactivate_session() {
  local pid=$1
  local sid=$2
  local temporary_file="$ACTIVE_SESSION_OWNERSHIP_FILE.tmp.$$"

  touch "$ACTIVE_SESSION_OWNERSHIP_FILE"
  awk -F '\t' -v pid="$pid" -v sid="$sid" \
    '!(($2 == pid) && ($3 == sid))' "$ACTIVE_SESSION_OWNERSHIP_FILE" > "$temporary_file"
  mv "$temporary_file" "$ACTIVE_SESSION_OWNERSHIP_FILE"
}

deactivate_run_token() {
  local token=$1
  local temporary_file="$ACTIVE_TOKEN_OWNERSHIP_FILE.tmp.$$"

  touch "$ACTIVE_TOKEN_OWNERSHIP_FILE"
  awk -F '\t' -v token="$token" '$2 != token' \
    "$ACTIVE_TOKEN_OWNERSHIP_FILE" > "$temporary_file"
  mv "$temporary_file" "$ACTIVE_TOKEN_OWNERSHIP_FILE"
}

session_process_rows() {
  local sid=$1

  all_process_rows \
    | awk -v sid="$sid" '
        $4 == sid && $5 !~ /^Z/ {
          printf "%s\t%s\t%s\t%s\t%s\t%s", $1, $2, $3, $4, $5, $6
          for (field = 7; field <= NF; field++) printf "\t%s", $field
          printf "\n"
        }
      '
}

all_process_rows() {
  "$PROCESS_CENSUS_HELPER" all
}

session_zombie_rows() {
  local sid=$1

  [[ -n "$sid" ]] || return 0
  all_process_rows \
    | awk -v sid="$sid" '
        $4 == sid && $5 ~ /^Z/ {
          printf "%s\t%s\t%s\t%s\t%s\t%s", $1, $2, $3, $4, $5, $6
          for (field = 7; field <= NF; field++) printf "\t%s", $field
          printf "\n"
        }
      '
}

botster_role_zombie_rows() {
  all_process_rows | "$PROCESS_CENSUS_HELPER" botster-zombies-from-stdin
}

new_process_rows() {
  local baseline_file=$1
  local current_file=$2

  awk -F '\t' '
    FILENAME == ARGV[1] { baseline[$1]=1; next }
    !baseline[$1] { print }
  ' "$baseline_file" "$current_file"
}

settled_zombie_rows() {
  local sid=$1
  local baseline_file=$2
  local current_file="$ARTIFACT_DIR/zombie-current.$$.tmp"
  local new_roles_file="$ARTIFACT_DIR/zombie-new-roles.$$.tmp"
  local tagged_file="$ARTIFACT_DIR/zombie-tagged.$$.tmp"

  if ! botster_role_zombie_rows > "$current_file"; then
    rm -f "$current_file" "$new_roles_file" "$tagged_file"
    return 2
  fi
  if ! new_process_rows "$baseline_file" "$current_file" > "$new_roles_file"; then
    rm -f "$current_file" "$new_roles_file" "$tagged_file"
    return 2
  fi
  if ! awk -F '\t' '{ print "new-role\t" $0 }' "$new_roles_file" > "$tagged_file"; then
    rm -f "$current_file" "$new_roles_file" "$tagged_file"
    return 2
  fi
  if ! session_zombie_rows "$sid" \
    | awk -F '\t' '{ print "recorded-session\t" $0 }' >> "$tagged_file"; then
    rm -f "$current_file" "$new_roles_file" "$tagged_file"
    return 2
  fi
  if ! awk -F '\t' '!seen[$2]++' "$tagged_file"; then
    rm -f "$current_file" "$new_roles_file" "$tagged_file"
    return 2
  fi
  rm -f "$current_file" "$new_roles_file" "$tagged_file"
}

capture_settled_zombie_survivors() {
  local sid=$1
  local baseline_file=$2
  local evidence_file=$3
  local rows_file="$ARTIFACT_DIR/zombie-rows.$$.tmp"
  local deadline=$((SECONDS + ZOMBIE_SETTLE_SECONDS))
  local survivor_count

  while :; do
    if ! settled_zombie_rows "$sid" "$baseline_file" > "$rows_file"; then
      cleanup_log "zombie_census=error settle_seconds=$ZOMBIE_SETTLE_SECONDS"
      rm -f "$rows_file"
      return 2
    fi
    [[ ! -s "$rows_file" ]] && break
    ((SECONDS >= deadline)) && break
    sleep 0.1
  done
  survivor_count=$(awk 'END { print NR + 0 }' "$rows_file")
  {
    printf 'source\tpid\tppid\tpgid\tsid\tstat\tcomm\targs\n'
    awk -v limit="$SURVIVOR_EVIDENCE_LIMIT" 'NR <= limit { print }' "$rows_file"
    if ((survivor_count > SURVIVOR_EVIDENCE_LIMIT)); then
      printf 'truncated\t%s\tlimit=%s\n' "$survivor_count" "$SURVIVOR_EVIDENCE_LIMIT"
    fi
  } > "$evidence_file"
  rm -f "$rows_file"

  if ((survivor_count > 0)); then
    cleanup_log "zombie_survivors=$survivor_count settle_seconds=$ZOMBIE_SETTLE_SECONDS evidence=$(basename "$evidence_file")"
    return 1
  fi
  cleanup_log "zombie_survivors=0 settle_seconds=$ZOMBIE_SETTLE_SECONDS evidence=$(basename "$evidence_file")"
  return 0
}

process_has_run_token() {
  local environment_file=$1
  local token=$2
  local entry

  while IFS= read -r -d '' entry; do
    [[ "$entry" == "BOTSTER_LOADED_RUN_TOKEN=$token" ]] && return 0
  done < "$environment_file"
  return 1
}

run_token_process_rows() {
  local token=$1
  local environment_file pid ps_error_file ps_rows_file token_file

  if [[ "$(runner_platform)" == Darwin ]]; then
    token_file="$ARTIFACT_DIR/run-token-query.$$.tmp"
    ps_rows_file="$ARTIFACT_DIR/run-token-ps.$$.tmp"
    ps_error_file="$ARTIFACT_DIR/run-token-ps.$$.stderr"
    if [[ -z "$token" ]] || ! printf '%s\n' "$token" > "$token_file"; then
      log "Darwin run-token census requires a non-empty readable token"
      rm -f "$token_file" "$ps_rows_file"
      return 1
    fi
    if ! ps eww -axo pid=,ppid=,pgid=,sess=,stat=,comm=,args= \
      > "$ps_rows_file" 2> "$ps_error_file"; then
      log "Darwin run-token census ps failed; see $(basename "$ps_error_file")"
      rm -f "$token_file" "$ps_rows_file"
      return 1
    fi
    if ! awk -v token_file="$token_file" '
          BEGIN {
            if ((getline token < token_file) != 1 || token == "") exit 2
            close(token_file)
            token = "BOTSTER_LOADED_RUN_TOKEN=" token
          }
          index($0, token) && $5 !~ /^Z/ {
            printf "%s\t%s\t%s\t%s\t%s\t%s", $1, $2, $3, $4, $5, $6
            for (field = 7; field <= NF; field++) printf "\t%s", $field
            printf "\n"
          }
        ' "$ps_rows_file"; then
      log "Darwin run-token census token read failed"
      rm -f "$token_file" "$ps_rows_file"
      return 1
    fi
    rm -f "$token_file" "$ps_rows_file" "$ps_error_file"
    return
  fi

  for environment_file in /proc/[0-9]*/environ; do
    [[ -r "$environment_file" ]] || continue
    process_has_run_token "$environment_file" "$token" 2>/dev/null || continue
    pid=${environment_file#/proc/}
    pid=${pid%/environ}
    ps -o pid=,ppid=,pgid=,sid=,stat=,comm=,args= -p "$pid" 2>/dev/null \
      | awk '$5 !~ /^Z/ {
          printf "%s\t%s\t%s\t%s\t%s\t%s", $1, $2, $3, $4, $5, $6
          for (field = 7; field <= NF; field++) printf "\t%s", $field
          printf "\n"
        }'
  done
}

capture_run_token_survivors() {
  local role=$1
  local token=$2
  local evidence_file=$3
  local rows_file="$ARTIFACT_DIR/run-token-rows.$$.tmp"
  local survivor_count

  if ! run_token_process_rows "$token" > "$rows_file"; then
    cleanup_log "role=$role run_token=$token census_status=failed"
    rm -f "$rows_file"
    return 1
  fi
  survivor_count=$(awk 'END { print NR + 0 }' "$rows_file")
  {
    printf 'role\tpid\tppid\tpgid\tsid\tstat\tcomm\targs\n'
    awk -v role="$role" -v limit="$SURVIVOR_EVIDENCE_LIMIT" \
      'NR <= limit { print role "\t" $0 }' "$rows_file"
    if ((survivor_count > SURVIVOR_EVIDENCE_LIMIT)); then
      printf 'truncated\t%s\tlimit=%s\n' "$survivor_count" "$SURVIVOR_EVIDENCE_LIMIT"
    fi
  } > "$evidence_file"
  rm -f "$rows_file"

  if ((survivor_count > 0)); then
    cleanup_log "role=$role run_token=$token live_survivors=$survivor_count evidence=$(basename "$evidence_file")"
    return 1
  fi
  cleanup_log "role=$role run_token=$token live_survivors=0 evidence=$(basename "$evidence_file")"
  return 0
}

capture_session_survivors() {
  local role=$1
  local sid=$2
  local evidence_file=$3
  local rows_file="$ARTIFACT_DIR/session-rows.$$.tmp"
  local survivor_count

  session_process_rows "$sid" > "$rows_file"
  survivor_count=$(awk 'END { print NR + 0 }' "$rows_file")
  {
    printf 'role\tpid\tppid\tpgid\tsid\tstat\tcomm\targs\n'
    awk -v role="$role" -v limit="$SURVIVOR_EVIDENCE_LIMIT" \
      'NR <= limit { print role "\t" $0 }' "$rows_file"
    if ((survivor_count > SURVIVOR_EVIDENCE_LIMIT)); then
      printf 'truncated\t%s\tlimit=%s\n' "$survivor_count" "$SURVIVOR_EVIDENCE_LIMIT"
    fi
  } > "$evidence_file"
  rm -f "$rows_file"

  if ((survivor_count > 0)); then
    cleanup_log "role=$role sid=$sid live_survivors=$survivor_count evidence=$(basename "$evidence_file")"
    return 1
  fi
  cleanup_log "role=$role sid=$sid live_survivors=0 evidence=$(basename "$evidence_file")"
  return 0
}

cleanup_session() {
  local role=$1
  local pid=$2
  local sid=$3
  local rows_file="$ARTIFACT_DIR/session-cleanup-rows.$$.tmp"
  local groups_file="$ARTIFACT_DIR/session-cleanup-groups.$$.tmp"
  local cleanup_pass representative_pid pgid
  local cleanup_status=0

  [[ "$pid" =~ ^[0-9]+$ && "$sid" =~ ^[0-9]+$ ]] || return 0
  for cleanup_pass in {1..3}; do
    session_process_rows "$sid" > "$rows_file"
    [[ -s "$rows_file" ]] || break
    awk -F '\t' '!seen[$3]++ { print $1 "\t" $3 }' "$rows_file" > "$groups_file"
    while IFS=$'\t' read -r representative_pid pgid; do
      [[ -n "$pgid" ]] || continue
      cleanup_group "$role-session" "$representative_pid" "$pgid" no || true
    done < "$groups_file"
  done
  rm -f "$rows_file" "$groups_file"

  if [[ -n "$(session_process_rows "$sid")" ]]; then
    cleanup_log "role=$role pid=$pid sid=$sid post_clean=alive"
    cleanup_status=1
  else
    cleanup_log "role=$role pid=$pid sid=$sid post_clean=gone"
    deactivate_session "$pid" "$sid"
  fi
  return "$cleanup_status"
}

verify_and_cleanup_session() {
  local role=$1
  local pid=$2
  local sid=$3
  local evidence_file=$4

  if capture_session_survivors "$role" "$sid" "$evidence_file"; then
    deactivate_session "$pid" "$sid"
    return 0
  fi
  cleanup_session "$role" "$pid" "$sid" || true
  return 1
}

cleanup_run_token() {
  local role=$1
  local token=$2
  local rows_file="$ARTIFACT_DIR/run-token-cleanup-rows.$$.tmp"
  local groups_file="$ARTIFACT_DIR/run-token-cleanup-groups.$$.tmp"
  local cleanup_pass representative_pid pgid
  local cleanup_status=0

  [[ -n "$token" ]] || return 0
  for cleanup_pass in {1..3}; do
    if ! run_token_process_rows "$token" > "$rows_file"; then
      cleanup_log "role=$role run_token=$token cleanup_census_status=failed"
      cleanup_status=1
      break
    fi
    [[ -s "$rows_file" ]] || break
    awk -F '\t' '!seen[$3]++ { print $1 "\t" $3 }' "$rows_file" > "$groups_file"
    while IFS=$'\t' read -r representative_pid pgid; do
      [[ -n "$pgid" ]] || continue
      cleanup_group "$role-token" "$representative_pid" "$pgid" no || true
    done < "$groups_file"
  done
  rm -f "$rows_file" "$groups_file"

  local remaining_rows
  if ! remaining_rows=$(run_token_process_rows "$token"); then
    cleanup_log "role=$role run_token=$token post_clean=census-failed"
    return 1
  fi
  if [[ -n "$remaining_rows" ]]; then
    cleanup_log "role=$role run_token=$token post_clean=alive"
    cleanup_status=1
  else
    cleanup_log "role=$role run_token=$token post_clean=gone"
    deactivate_run_token "$token"
  fi
  return "$cleanup_status"
}

verify_and_cleanup_run_token() {
  local role=$1
  local token=$2
  local evidence_file=$3

  if capture_run_token_survivors "$role" "$token" "$evidence_file"; then
    deactivate_run_token "$token"
    return 0
  fi
  cleanup_run_token "$role" "$token" || true
  return 1
}

cleanup_group() {
  local role=$1
  local pid=$2
  local pgid=$3
  local wait_direct=${4:-yes}
  local deadline
  local status=0

  [[ "$pid" =~ ^[0-9]+$ && "$pgid" =~ ^[0-9]+$ ]] || return 0
  if group_is_alive "$pgid"; then
    cleanup_log "role=$role pid=$pid pgid=$pgid action=TERM"
    kill -TERM -- "-$pgid" 2>/dev/null || true
    deadline=$((SECONDS + CLEANUP_GRACE_SECONDS))
    while group_is_alive "$pgid" && ((SECONDS < deadline)); do
      sleep 1
    done
  fi
  if group_is_alive "$pgid"; then
    cleanup_log "role=$role pid=$pid pgid=$pgid action=KILL"
    kill -KILL -- "-$pgid" 2>/dev/null || true
    sleep 1
  fi
  if [[ "$wait_direct" == yes ]]; then
    wait "$pid" 2>/dev/null || true
    cleanup_log "role=$role pid=$pid pgid=$pgid action=waited"
  fi
  if group_is_alive "$pgid"; then
    cleanup_log "role=$role pid=$pid pgid=$pgid post_clean=alive"
    status=1
  else
    cleanup_log "role=$role pid=$pid pgid=$pgid post_clean=gone"
    deactivate_group "$pid" "$pgid"
  fi
  return "$status"
}

cleanup_recorded_groups() {
  local cleanup_status=0
  local role pid pgid started_at

  touch "$ACTIVE_OWNERSHIP_FILE"
  while IFS=$'\t' read -r role pid pgid started_at; do
    [[ -n "$role" ]] || continue
    cleanup_group "$role" "$pid" "$pgid" no || cleanup_status=1
  done < "$ACTIVE_OWNERSHIP_FILE"
  return "$cleanup_status"
}

cleanup_recorded_sessions() {
  local cleanup_status=0
  local role pid sid started_at

  touch "$ACTIVE_SESSION_OWNERSHIP_FILE"
  while IFS=$'\t' read -r role pid sid started_at; do
    [[ -n "$role" ]] || continue
    cleanup_session "$role" "$pid" "$sid" || cleanup_status=1
  done < "$ACTIVE_SESSION_OWNERSHIP_FILE"
  return "$cleanup_status"
}

cleanup_recorded_run_tokens() {
  local cleanup_status=0
  local role token started_at

  touch "$ACTIVE_TOKEN_OWNERSHIP_FILE"
  while IFS=$'\t' read -r role token started_at; do
    [[ -n "$role" ]] || continue
    cleanup_run_token "$role" "$token" || cleanup_status=1
  done < "$ACTIVE_TOKEN_OWNERSHIP_FILE"
  return "$cleanup_status"
}

# Called through finalize's EXIT trap.
# shellcheck disable=SC2329
cleanup_active_groups() {
  local cleanup_status=0

  cleanup_run_token test "${TEST_RUN_TOKEN:-}" || cleanup_status=1
  TEST_RUN_TOKEN=
  cleanup_recorded_run_tokens || cleanup_status=1
  cleanup_session test "${TEST_PID:-}" "${TEST_SID:-}" || cleanup_status=1
  TEST_SID=
  cleanup_recorded_sessions || cleanup_status=1
  cleanup_group test "${TEST_PID:-}" "${TEST_PGID:-}" yes || cleanup_status=1
  TEST_PID=
  TEST_PGID=
  cleanup_group sampler "${SAMPLER_PID:-}" "${SAMPLER_PGID:-}" yes || cleanup_status=1
  SAMPLER_PID=
  SAMPLER_PGID=
  cleanup_group load "${LOAD_PID:-}" "${LOAD_PGID:-}" yes || cleanup_status=1
  LOAD_PID=
  LOAD_PGID=
  return "$cleanup_status"
}

# Called by the EXIT trap installed after input parsing.
# shellcheck disable=SC2329
finalize() {
  local incoming_status=$1
  local cleanup_status=0

  ((FINALIZED == 0)) || return
  FINALIZED=1
  trap - EXIT INT TERM HUP
  cleanup_active_groups || cleanup_status=1
  if ((incoming_status == 0 && cleanup_status != 0)); then
    incoming_status=1
  fi
  printf 'finished_at=%s\nexit_status=%s\ncleanup_status=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$incoming_status" "$cleanup_status" \
    >> "$ARTIFACT_DIR/campaign-summary.txt"
  log "campaign_exit_status=$incoming_status cleanup_status=$cleanup_status"
  exit "$incoming_status"
}

record_group() {
  local role=$1
  local pid=$2
  local pgid=
  local group_member_count=not-counted

  for _ in {1..100}; do
    pgid=$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d '[:space:]')
    [[ "$pgid" == "$pid" ]] && break
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.05
  done
  if [[ -z "$pgid" || "$pgid" != "$pid" ]]; then
    log "failed to establish owned process group for role=$role pid=$pid pgid=${pgid:-missing}"
    return 1
  fi
  if [[ "$(runner_platform)" == Darwin && "$role" == test ]]; then
    for _ in {1..100}; do
      group_member_count=$(ps -eo pgid= 2>/dev/null | awk -v pgid="$pgid" '$1 == pgid { count++ } END { print count + 0 }')
      ((group_member_count > 1)) && break
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.05
    done
    if ((group_member_count < 2)); then
      log "owned Darwin test group did not contain the launched test tree role=$role pid=$pid pgid=$pgid members=$group_member_count"
      return 1
    fi
  fi
  printf '%s\t%s\t%s\t%s\n' "$role" "$pid" "$pgid" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$OWNERSHIP_FILE"
  printf '%s\t%s\t%s\t%s\n' "$role" "$pid" "$pgid" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$ACTIVE_OWNERSHIP_FILE"
  log "owned_group role=$role pid=$pid pgid=$pgid members=$group_member_count"
  RECORDED_PGID=$pgid
}

record_session() {
  local role=$1
  local pid=$2
  local sid=

  for _ in {1..100}; do
    sid=$(ps -o sid= -p "$pid" 2>/dev/null | tr -d '[:space:]')
    [[ "$sid" == "$pid" ]] && break
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.05
  done
  if [[ -z "$sid" || "$sid" != "$pid" ]]; then
    log "failed to establish owned process session for role=$role pid=$pid sid=${sid:-missing}"
    return 1
  fi
  printf '%s\t%s\t%s\t%s\n' "$role" "$pid" "$sid" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$SESSION_OWNERSHIP_FILE"
  printf '%s\t%s\t%s\t%s\n' "$role" "$pid" "$sid" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$ACTIVE_SESSION_OWNERSHIP_FILE"
  log "owned_session role=$role pid=$pid sid=$sid"
  RECORDED_SID=$sid
}

record_run_token() {
  local role=$1
  local token=$2
  local started_at

  [[ "$token" =~ ^[a-zA-Z0-9._:-]+$ ]] || return 1
  started_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  printf '%s\t%s\t%s\n' "$role" "$token" "$started_at" >> "$TOKEN_OWNERSHIP_FILE"
  printf '%s\t%s\t%s\n' "$role" "$token" "$started_at" >> "$ACTIVE_TOKEN_OWNERSHIP_FILE"
  log "owned_run_token role=$role token=$token"
}

terminate_unrecorded_process() {
  local role=$1
  local pid=$2
  local pgid

  pgid=$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d '[:space:]')
  if [[ "$pgid" == "$pid" ]]; then
    cleanup_group "$role" "$pid" "$pgid" yes || true
  else
    cleanup_log "role=$role pid=$pid pgid=${pgid:-missing} action=TERM-unrecorded"
    kill -TERM "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  fi
}

start_load() {
  local cpu_count=$1
  local workers=0

  case "$STRESS_PROFILE" in
    residual-tail) workers=$((cpu_count * 12)); ((workers > 64)) && workers=64 ;;
    moderate) workers=$((cpu_count * 2)); ((workers > 16)) && workers=16 ;;
    none) workers=0 ;;
  esac
  printf 'cpu_count=%s\nstress_workers=%s\n' "$cpu_count" "$workers" >> "$ARTIFACT_DIR/metadata.txt"
  log "stress_profile=$STRESS_PROFILE cpu_count=$cpu_count workers=$workers"
  ((workers > 0)) || return 0

  # Variables in this single-quoted program expand inside the owned Bash group.
  # shellcheck disable=SC2016
  start_owned_group bash -c '
    workers=$1
    for ((worker = 1; worker <= workers; worker++)); do
      bash -c "while :; do :; done" &
    done
    wait
  ' load "$workers"
  LOAD_PID=$STARTED_PID
  if ! record_group load "$LOAD_PID"; then
    terminate_unrecorded_process load "$LOAD_PID"
    LOAD_PID=
    return 1
  fi
  LOAD_PGID=$RECORDED_PGID
}

start_sampler() {
  local samples_file=$1

  # Variables in this single-quoted program expand inside the owned Bash group.
  # shellcheck disable=SC2016
  start_owned_group bash -c '
    samples_file=$1
    while :; do
      {
        printf "sample_at=%s\n" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        printf "uptime_seconds=%s\n" "$SECONDS"
        printf "loadavg="
        cat /proc/loadavg
        free -m
        ps -eo pid,ppid,pgid,sid,stat,pcpu,pmem,etimes,comm,args --sort=-pcpu | head -80
        printf "sample_end\n"
      } | tee -a "$samples_file"
      sleep 5
    done
  ' sampler "$samples_file"
  SAMPLER_PID=$STARTED_PID
  if ! record_group sampler "$SAMPLER_PID"; then
    terminate_unrecorded_process sampler "$SAMPLER_PID"
    SAMPLER_PID=
    return 1
  fi
  SAMPLER_PGID=$RECORDED_PGID
}

run_repetition() {
  local repetition=$1
  local timeout_seconds=$2
  local run_log
  local survivor_evidence
  local owned_survivor_evidence
  local zombie_baseline
  local zombie_survivor_evidence
  local run_token
  local test_sid
  local started_at=$SECONDS
  local status
  shift 2
  local -a command=("$@")

  run_log=$(printf '%s/run-%03d.log' "$ARTIFACT_DIR" "$repetition")
  printf 'run=%s\tstarted_at=%s\ttimeout_seconds=%s\n' \
    "$repetition" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$timeout_seconds" \
    >> "$ARTIFACT_DIR/campaign-status.tsv"
  {
    printf 'run=%s command=' "$repetition"
    printf '%q ' "${command[@]}"
    printf '\n'
  } >> "$ARTIFACT_DIR/commands.txt"
  log "run=$repetition stage=test-start timeout_seconds=$timeout_seconds"

  run_token="botster-loaded-${SUBJECT_SHA}-${repetition}-$$-$RANDOM"
  zombie_baseline=$(printf '%s/run-%03d-zombie-baseline.tsv' "$ARTIFACT_DIR" "$repetition")
  if ! botster_role_zombie_rows > "$zombie_baseline"; then
    log "run=$repetition stage=zombie-baseline exit_status=2"
    return 2
  fi
  record_run_token test "$run_token" || return 1
  TEST_RUN_TOKEN=$run_token

  # Variables in this single-quoted program expand inside the owned Bash group.
  # shellcheck disable=SC2016
  start_owned_group bash -c '
    set -o pipefail
    subject_dir=$1
    run_log=$2
    run_token=$3
    shift 3
    export BOTSTER_LOADED_RUN_TOKEN="$run_token"
    cd "$subject_dir"
    "$@" 2>&1 | tee "$run_log"
  ' test "$SUBJECT_DIR" "$run_log" "$run_token" "${command[@]}"
  TEST_PID=$STARTED_PID
  if ! record_group test "$TEST_PID"; then
    terminate_unrecorded_process test "$TEST_PID"
    TEST_PID=
    return 1
  fi
  TEST_PGID=$RECORDED_PGID
  if [[ "$(runner_platform)" == Linux ]]; then
    if ! record_session test "$TEST_PID"; then
      terminate_unrecorded_process test "$TEST_PID"
      TEST_PID=
      TEST_PGID=
      return 1
    fi
    TEST_SID=$RECORDED_SID
  fi
  while direct_child_is_running "$TEST_PID" && ((SECONDS - started_at < timeout_seconds)); do
    sleep 0.1
  done
  if direct_child_is_running "$TEST_PID"; then
    cleanup_log "role=test pid=$TEST_PID pgid=$TEST_PGID action=timeout"
    cleanup_group test "$TEST_PID" "$TEST_PGID" yes || true
    status=124
  else
    wait "$TEST_PID"
    status=$?
  fi
  owned_survivor_evidence=$(printf '%s/run-%03d-owned-survivors.tsv' "$ARTIFACT_DIR" "$repetition")
  verify_and_cleanup_run_token test "$TEST_RUN_TOKEN" "$owned_survivor_evidence" || status=1
  TEST_RUN_TOKEN=
  if [[ -n "$TEST_SID" ]]; then
    survivor_evidence=$(printf '%s/run-%03d-session-survivors.tsv' "$ARTIFACT_DIR" "$repetition")
    verify_and_cleanup_session test "$TEST_PID" "$TEST_SID" "$survivor_evidence" || status=1
    test_sid=$TEST_SID
    TEST_SID=
  fi
  cleanup_group test "$TEST_PID" "$TEST_PGID" no || status=1
  TEST_PID=
  TEST_PGID=
  zombie_survivor_evidence=$(printf '%s/run-%03d-zombie-survivors.tsv' "$ARTIFACT_DIR" "$repetition")
  capture_settled_zombie_survivors "${test_sid:-}" "$zombie_baseline" \
    "$zombie_survivor_evidence" || status=1

  printf 'run=%s\tfinished_at=%s\telapsed_seconds=%s\texit_status=%s\n' \
    "$repetition" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$((SECONDS - started_at))" "$status" \
    >> "$ARTIFACT_DIR/campaign-status.tsv"
  log "run=$repetition stage=test-finish elapsed_seconds=$((SECONDS - started_at)) exit_status=$status"
  return "$status"
}

main() {
  local status=0
  local cpu_count campaign_deadline remaining_seconds effective_timeout run
  local -a test_command

  while (($# > 0)); do
    case "$1" in
      --subject-dir) SUBJECT_DIR=${2-}; shift 2 ;;
      --artifact-dir) ARTIFACT_DIR=${2-}; shift 2 ;;
      --subject-sha) SUBJECT_SHA=${2-}; shift 2 ;;
      --test-target) TEST_TARGET=${2-}; shift 2 ;;
      --repetitions) REPETITIONS=${2-}; shift 2 ;;
      --stress-profile) STRESS_PROFILE=${2-}; shift 2 ;;
      --validate-only) MODE=validate; shift ;;
      --cleanup-only) MODE=cleanup; shift ;;
      --help|-h) usage; return 0 ;;
      *) printf 'unknown argument: %s\n' "$1" >&2; usage >&2; return 2 ;;
    esac
  done

  if [[ -z "$ARTIFACT_DIR" ]]; then
    printf '%s\n' '--artifact-dir is required' >&2
    return 2
  fi
  mkdir -p "$ARTIFACT_DIR"
  ARTIFACT_DIR=$(cd "$ARTIFACT_DIR" && pwd)
  CLEANUP_LOG="$ARTIFACT_DIR/cleanup.log"
  OWNERSHIP_FILE="$ARTIFACT_DIR/owned-pgids.tsv"
  ACTIVE_OWNERSHIP_FILE="$ARTIFACT_DIR/active-pgids.tsv"
  SESSION_OWNERSHIP_FILE="$ARTIFACT_DIR/owned-sessions.tsv"
  ACTIVE_SESSION_OWNERSHIP_FILE="$ARTIFACT_DIR/active-sessions.tsv"
  TOKEN_OWNERSHIP_FILE="$ARTIFACT_DIR/owned-run-tokens.tsv"
  ACTIVE_TOKEN_OWNERSHIP_FILE="$ARTIFACT_DIR/active-run-tokens.tsv"
  touch "$OWNERSHIP_FILE" "$ACTIVE_OWNERSHIP_FILE" "$SESSION_OWNERSHIP_FILE" \
    "$ACTIVE_SESSION_OWNERSHIP_FILE" "$TOKEN_OWNERSHIP_FILE" \
    "$ACTIVE_TOKEN_OWNERSHIP_FILE" "$CLEANUP_LOG"

  if [[ "$MODE" == cleanup ]]; then
    cleanup_log "external_cleanup=start"
    cleanup_recorded_run_tokens || status=1
    cleanup_recorded_sessions || status=1
    cleanup_recorded_groups || status=1
    cleanup_log "external_cleanup=finish status=$status"
    return "$status"
  fi

  trap 'finalize $?' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP

  validate_inputs || return $?
  if [[ "$MODE" == validate ]]; then
    cleanup_log "validation_only post_clean=no_processes_started"
    return 0
  fi
  if [[ -z "$SUBJECT_DIR" || ! -x "$SUBJECT_DIR/test.sh" ]]; then
    log "subject checkout must contain an executable test.sh: ${SUBJECT_DIR:-missing}"
    return 2
  fi
  validate_runner || return 2
  SUBJECT_DIR=$(cd "$SUBJECT_DIR" && pwd)

  resolve_run_timeout
  CAMPAIGN_TIMEOUT_SECONDS=${BOTSTER_LOADED_CAMPAIGN_TIMEOUT_SECONDS:-$DEFAULT_CAMPAIGN_TIMEOUT_SECONDS}
  if [[ ! "$RUN_TIMEOUT_SECONDS" =~ ^[0-9]+$ ]] || ((RUN_TIMEOUT_SECONDS < 5 || RUN_TIMEOUT_SECONDS > RUN_TIMEOUT_MAX)); then
    log "invalid BOTSTER_LOADED_RUN_TIMEOUT_SECONDS: expected 5-${RUN_TIMEOUT_MAX}"
    return 2
  fi
  if [[ ! "$CAMPAIGN_TIMEOUT_SECONDS" =~ ^[0-9]+$ ]] || ((CAMPAIGN_TIMEOUT_SECONDS < RUN_TIMEOUT_SECONDS || CAMPAIGN_TIMEOUT_SECONDS > 20400)); then
    log "invalid BOTSTER_LOADED_CAMPAIGN_TIMEOUT_SECONDS: expected run timeout through 20400"
    return 2
  fi

  case "$TEST_TARGET" in
    lifecycle-suite)
      test_command=(./test.sh --test hub_daemon_lifecycle_test -- --nocapture)
      ;;
    focused-metadata-owned-shutdown)
      test_command=(./test.sh --test hub_daemon_lifecycle_test metadata_owned_daemon -- --nocapture)
      ;;
    focused-occupied-web-port)
      test_command=(./test.sh --test hub_daemon_lifecycle_test occupied_generic_web_port_reports_structured_entrypoint_failure -- --exact --nocapture)
      ;;
    focused-session-entity-resize)
      test_command=(./test.sh --test hub_daemon_lifecycle_test session_entity_subscription_pushes_snapshot_ordered_deltas_and_fresh_reconnect -- --exact --nocapture)
      ;;
    focused-process-ownership)
      test_command=(./test.sh --test hub_daemon_lifecycle_test process_ownership_ -- --nocapture)
      ;;
    focused-connection-lifecycle)
      test_command=(./test.sh --test hub_daemon_lifecycle_test focused_connection_lifecycle_is_bounded_event_driven_and_counter_visible -- --exact --nocapture)
      ;;
    focused-plugin-resource-bounds)
      test_command=(env BOTSTER_ASSERT_IDLE_CPU_BOUND=1 ./test.sh --test hub_daemon_lifecycle_test focused_plugin_resources_are_bounded_across_reconnect_reload_idle_and_unload -- --exact --nocapture)
      ;;
    focused-stalled-attach)
      test_command=(./test.sh --test hub_daemon_lifecycle_test stalled_attach_stdout_does_not_block_other_daemon_commands -- --exact --nocapture)
      ;;
    focused-fast-exit-attach-diagnostic)
      test_command=(./test.sh --test hub_daemon_lifecycle_test fast_exit_attach_diagnostic_records_subscription_event_order -- --exact --nocapture)
      ;;
    focused-oversized-webrtc)
      test_command=(./test.sh --test hub_daemon_lifecycle_test local_webrtc_chunks_oversized_encrypted_daemon_response -- --exact --nocapture)
      ;;
    focused-cli-smoke)
      test_command=(./test.sh --test hub_daemon_lifecycle_test cli_smoke_proves_local_runtime_daemon_package_app_session_and_webrtc -- --exact --nocapture)
      ;;
    focused-operator-console)
      test_command=(./test.sh --test hub_daemon_lifecycle_test cli_operator_console_starts_reuses_detaches_handles_ctrl_c_and_stops -- --exact --nocapture)
      ;;
    focused-lua-worker-suite)
      test_command=(./test.sh --test hub_lua_runtime_test -- --nocapture)
      ;;
    focused-lua-session-worker-callers)
      test_command=(./test.sh --test hub_lua_runtime_test session_type -- --nocapture)
      ;;
    event-plane-saturation)
      export BOTSTER_EVENT_PLANE_PHASE="${BOTSTER_EVENT_PLANE_PHASE:?event-plane-saturation requires BOTSTER_EVENT_PLANE_PHASE}"
      export BOTSTER_EVENT_PLANE_ARTIFACT_DIR="${BOTSTER_EVENT_PLANE_ARTIFACT_DIR:-$ARTIFACT_DIR}"
      export SUBJECT_SHA="$SUBJECT_SHA"
      test_command=(./test.sh --test hub_daemon_lifecycle_test event_plane_saturation_campaign -- --exact --ignored --nocapture)
      ;;
    full-suite-contention)
      test_command=(./test.sh)
      ;;
  esac

  touch "$ARTIFACT_DIR/campaign-status.tsv" "$ARTIFACT_DIR/commands.txt"
  printf 'started_at=%s\nrun_timeout_seconds=%s\ncampaign_timeout_seconds=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$RUN_TIMEOUT_SECONDS" "$CAMPAIGN_TIMEOUT_SECONDS" \
    >> "$ARTIFACT_DIR/campaign-summary.txt"

  cpu_count=$(runner_cpu_count)
  start_load "$cpu_count" || return 1
  if [[ "$(runner_platform)" == Linux ]]; then
    start_sampler "$ARTIFACT_DIR/resource-samples.log" || return 1
  fi

  campaign_deadline=$((SECONDS + CAMPAIGN_TIMEOUT_SECONDS))
  for ((run = 1; run <= 10#$REPETITIONS; run++)); do
    remaining_seconds=$((campaign_deadline - SECONDS))
    if ((remaining_seconds < 5)); then
      log "campaign deadline reached before run=$run"
      return 124
    fi
    effective_timeout=$RUN_TIMEOUT_SECONDS
    ((remaining_seconds < effective_timeout)) && effective_timeout=$remaining_seconds
    run_repetition "$run" "$effective_timeout" "${test_command[@]}"
    status=$?
    if ((status != 0)); then
      log "stopping at first red run=$run exit_status=$status"
      return "$status"
    fi
  done

  return 0
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
