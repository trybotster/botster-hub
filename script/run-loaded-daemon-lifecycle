#!/usr/bin/env bash
set -uo pipefail

readonly DEFAULT_RUN_TIMEOUT_SECONDS=900
readonly DEFAULT_CAMPAIGN_TIMEOUT_SECONDS=19800
readonly CLEANUP_GRACE_SECONDS=30
readonly SURVIVOR_EVIDENCE_LIMIT=80

MODE=run
SUBJECT_DIR=
ARTIFACT_DIR=
SUBJECT_SHA=
TEST_TARGET=
REPETITIONS=
STRESS_PROFILE=

LOAD_PID=
LOAD_PGID=
SAMPLER_PID=
SAMPLER_PGID=
TEST_PID=
TEST_PGID=
TEST_SID=
RECORDED_PGID=
RECORDED_SID=
FINALIZED=0
CLEANUP_LOG=
OWNERSHIP_FILE=
ACTIVE_OWNERSHIP_FILE=
SESSION_OWNERSHIP_FILE=
ACTIVE_SESSION_OWNERSHIP_FILE=

usage() {
  cat <<'USAGE'
Usage:
  run-loaded-daemon-lifecycle --subject-dir DIR --artifact-dir DIR \
    --subject-sha SHA --test-target TARGET --repetitions COUNT \
    --stress-profile PROFILE
  run-loaded-daemon-lifecycle --validate-only --artifact-dir DIR \
    --subject-sha SHA --test-target TARGET --repetitions COUNT \
    --stress-profile PROFILE
  run-loaded-daemon-lifecycle --cleanup-only --artifact-dir DIR
USAGE
}

log() {
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" | tee -a "$ARTIFACT_DIR/harness.log"
}

cleanup_log() {
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" | tee -a "$CLEANUP_LOG"
}

validate_inputs() {
  local invalid=0

  if [[ ! "$SUBJECT_SHA" =~ ^[0-9a-f]{40}$ ]]; then
    log "invalid subject_sha: expected a lowercase 40-character commit SHA"
    invalid=1
  fi
  case "$TEST_TARGET" in
    lifecycle-suite|focused-stalled-attach|focused-fast-exit-attach-diagnostic|focused-oversized-webrtc|focused-cli-smoke) ;;
    *) log "invalid test_target: $TEST_TARGET"; invalid=1 ;;
  esac
  if [[ ! "$REPETITIONS" =~ ^[0-9]+$ ]] || ((10#$REPETITIONS < 1 || 10#$REPETITIONS > 100)); then
    log "invalid repetitions: expected an integer from 1 through 100"
    invalid=1
  fi
  case "$STRESS_PROFILE" in
    residual-tail|moderate|none) ;;
    *) log "invalid stress_profile: $STRESS_PROFILE"; invalid=1 ;;
  esac

  {
    printf 'validated_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'subject_sha=%s\n' "$SUBJECT_SHA"
    printf 'test_target=%s\n' "$TEST_TARGET"
    printf 'repetitions=%s\n' "$REPETITIONS"
    printf 'stress_profile=%s\n' "$STRESS_PROFILE"
  } >> "$ARTIFACT_DIR/metadata.txt"

  if ((invalid != 0)); then
    printf 'validation_status=invalid\n' >> "$ARTIFACT_DIR/metadata.txt"
    return 2
  fi
  printf 'validation_status=valid\n' >> "$ARTIFACT_DIR/metadata.txt"
}

validate_linux_runner() {
  local command_name
  local invalid=0

  for command_name in awk bash free nproc ps setsid tee timeout; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
      log "missing required Linux runner command: $command_name"
      invalid=1
    fi
  done
  if [[ ! -r /proc/loadavg ]]; then
    log "missing required Linux runner interface: /proc/loadavg"
    invalid=1
  fi
  ((invalid == 0))
}

group_is_alive() {
  local pgid=$1

  ps -eo pgid=,stat= | awk -v pgid="$pgid" '$1 == pgid && $2 !~ /^Z/ { found=1 } END { exit !found }'
}

deactivate_group() {
  local pid=$1
  local pgid=$2
  local temporary_file="$ACTIVE_OWNERSHIP_FILE.tmp.$$"

  touch "$ACTIVE_OWNERSHIP_FILE"
  awk -F '\t' -v pid="$pid" -v pgid="$pgid" \
    '!(($2 == pid) && ($3 == pgid))' "$ACTIVE_OWNERSHIP_FILE" > "$temporary_file"
  mv "$temporary_file" "$ACTIVE_OWNERSHIP_FILE"
}

deactivate_session() {
  local pid=$1
  local sid=$2
  local temporary_file="$ACTIVE_SESSION_OWNERSHIP_FILE.tmp.$$"

  touch "$ACTIVE_SESSION_OWNERSHIP_FILE"
  awk -F '\t' -v pid="$pid" -v sid="$sid" \
    '!(($2 == pid) && ($3 == sid))' "$ACTIVE_SESSION_OWNERSHIP_FILE" > "$temporary_file"
  mv "$temporary_file" "$ACTIVE_SESSION_OWNERSHIP_FILE"
}

session_process_rows() {
  local sid=$1

  ps -eo pid=,ppid=,pgid=,sid=,stat=,comm=,args= \
    | awk -v sid="$sid" '
        $4 == sid && $5 !~ /^Z/ {
          printf "%s\t%s\t%s\t%s\t%s\t%s", $1, $2, $3, $4, $5, $6
          for (field = 7; field <= NF; field++) printf "\t%s", $field
          printf "\n"
        }
      '
}

capture_session_survivors() {
  local role=$1
  local sid=$2
  local evidence_file=$3
  local rows_file="$ARTIFACT_DIR/session-rows.$$.tmp"
  local survivor_count

  session_process_rows "$sid" > "$rows_file"
  survivor_count=$(awk 'END { print NR + 0 }' "$rows_file")
  {
    printf 'role\tpid\tppid\tpgid\tsid\tstat\tcomm\targs\n'
    awk -v role="$role" -v limit="$SURVIVOR_EVIDENCE_LIMIT" \
      'NR <= limit { print role "\t" $0 }' "$rows_file"
    if ((survivor_count > SURVIVOR_EVIDENCE_LIMIT)); then
      printf 'truncated\t%s\tlimit=%s\n' "$survivor_count" "$SURVIVOR_EVIDENCE_LIMIT"
    fi
  } > "$evidence_file"
  rm -f "$rows_file"

  if ((survivor_count > 0)); then
    cleanup_log "role=$role sid=$sid survivor_count=$survivor_count evidence=$(basename "$evidence_file")"
    return 1
  fi
  cleanup_log "role=$role sid=$sid survivor_count=0 evidence=$(basename "$evidence_file")"
  return 0
}

cleanup_session() {
  local role=$1
  local pid=$2
  local sid=$3
  local rows_file="$ARTIFACT_DIR/session-cleanup-rows.$$.tmp"
  local groups_file="$ARTIFACT_DIR/session-cleanup-groups.$$.tmp"
  local cleanup_pass representative_pid pgid
  local cleanup_status=0

  [[ "$pid" =~ ^[0-9]+$ && "$sid" =~ ^[0-9]+$ ]] || return 0
  for cleanup_pass in {1..3}; do
    session_process_rows "$sid" > "$rows_file"
    [[ -s "$rows_file" ]] || break
    awk -F '\t' '!seen[$3]++ { print $1 "\t" $3 }' "$rows_file" > "$groups_file"
    while IFS=$'\t' read -r representative_pid pgid; do
      [[ -n "$pgid" ]] || continue
      cleanup_group "$role-session" "$representative_pid" "$pgid" no || true
    done < "$groups_file"
  done
  rm -f "$rows_file" "$groups_file"

  if [[ -n "$(session_process_rows "$sid")" ]]; then
    cleanup_log "role=$role pid=$pid sid=$sid post_clean=alive"
    cleanup_status=1
  else
    cleanup_log "role=$role pid=$pid sid=$sid post_clean=gone"
    deactivate_session "$pid" "$sid"
  fi
  return "$cleanup_status"
}

verify_and_cleanup_session() {
  local role=$1
  local pid=$2
  local sid=$3
  local evidence_file=$4

  if capture_session_survivors "$role" "$sid" "$evidence_file"; then
    deactivate_session "$pid" "$sid"
    return 0
  fi
  cleanup_session "$role" "$pid" "$sid" || true
  return 1
}

cleanup_group() {
  local role=$1
  local pid=$2
  local pgid=$3
  local wait_direct=${4:-yes}
  local deadline
  local status=0

  [[ "$pid" =~ ^[0-9]+$ && "$pgid" =~ ^[0-9]+$ ]] || return 0
  if group_is_alive "$pgid"; then
    cleanup_log "role=$role pid=$pid pgid=$pgid action=TERM"
    kill -TERM -- "-$pgid" 2>/dev/null || true
    deadline=$((SECONDS + CLEANUP_GRACE_SECONDS))
    while group_is_alive "$pgid" && ((SECONDS < deadline)); do
      sleep 1
    done
  fi
  if group_is_alive "$pgid"; then
    cleanup_log "role=$role pid=$pid pgid=$pgid action=KILL"
    kill -KILL -- "-$pgid" 2>/dev/null || true
    sleep 1
  fi
  if [[ "$wait_direct" == yes ]]; then
    wait "$pid" 2>/dev/null || true
    cleanup_log "role=$role pid=$pid pgid=$pgid action=waited"
  fi
  if group_is_alive "$pgid"; then
    cleanup_log "role=$role pid=$pid pgid=$pgid post_clean=alive"
    status=1
  else
    cleanup_log "role=$role pid=$pid pgid=$pgid post_clean=gone"
    deactivate_group "$pid" "$pgid"
  fi
  return "$status"
}

cleanup_recorded_groups() {
  local cleanup_status=0
  local role pid pgid started_at

  touch "$ACTIVE_OWNERSHIP_FILE"
  while IFS=$'\t' read -r role pid pgid started_at; do
    [[ -n "$role" ]] || continue
    cleanup_group "$role" "$pid" "$pgid" no || cleanup_status=1
  done < "$ACTIVE_OWNERSHIP_FILE"
  return "$cleanup_status"
}

cleanup_recorded_sessions() {
  local cleanup_status=0
  local role pid sid started_at

  touch "$ACTIVE_SESSION_OWNERSHIP_FILE"
  while IFS=$'\t' read -r role pid sid started_at; do
    [[ -n "$role" ]] || continue
    cleanup_session "$role" "$pid" "$sid" || cleanup_status=1
  done < "$ACTIVE_SESSION_OWNERSHIP_FILE"
  return "$cleanup_status"
}

# Called through finalize's EXIT trap.
# shellcheck disable=SC2329
cleanup_active_groups() {
  local cleanup_status=0

  cleanup_session test "${TEST_PID:-}" "${TEST_SID:-}" || cleanup_status=1
  TEST_SID=
  cleanup_recorded_sessions || cleanup_status=1
  cleanup_group test "${TEST_PID:-}" "${TEST_PGID:-}" yes || cleanup_status=1
  TEST_PID=
  TEST_PGID=
  cleanup_group sampler "${SAMPLER_PID:-}" "${SAMPLER_PGID:-}" yes || cleanup_status=1
  SAMPLER_PID=
  SAMPLER_PGID=
  cleanup_group load "${LOAD_PID:-}" "${LOAD_PGID:-}" yes || cleanup_status=1
  LOAD_PID=
  LOAD_PGID=
  return "$cleanup_status"
}

# Called by the EXIT trap installed after input parsing.
# shellcheck disable=SC2329
finalize() {
  local incoming_status=$1
  local cleanup_status=0

  ((FINALIZED == 0)) || return
  FINALIZED=1
  trap - EXIT INT TERM HUP
  cleanup_active_groups || cleanup_status=1
  if ((incoming_status == 0 && cleanup_status != 0)); then
    incoming_status=1
  fi
  printf 'finished_at=%s\nexit_status=%s\ncleanup_status=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$incoming_status" "$cleanup_status" \
    >> "$ARTIFACT_DIR/campaign-summary.txt"
  log "campaign_exit_status=$incoming_status cleanup_status=$cleanup_status"
  exit "$incoming_status"
}

record_group() {
  local role=$1
  local pid=$2
  local pgid=

  for _ in {1..100}; do
    pgid=$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d '[:space:]')
    [[ "$pgid" == "$pid" ]] && break
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.05
  done
  if [[ -z "$pgid" || "$pgid" != "$pid" ]]; then
    log "failed to establish owned process group for role=$role pid=$pid pgid=${pgid:-missing}"
    return 1
  fi
  printf '%s\t%s\t%s\t%s\n' "$role" "$pid" "$pgid" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$OWNERSHIP_FILE"
  printf '%s\t%s\t%s\t%s\n' "$role" "$pid" "$pgid" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$ACTIVE_OWNERSHIP_FILE"
  log "owned_group role=$role pid=$pid pgid=$pgid"
  RECORDED_PGID=$pgid
}

record_session() {
  local role=$1
  local pid=$2
  local sid=

  for _ in {1..100}; do
    sid=$(ps -o sid= -p "$pid" 2>/dev/null | tr -d '[:space:]')
    [[ "$sid" == "$pid" ]] && break
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.05
  done
  if [[ -z "$sid" || "$sid" != "$pid" ]]; then
    log "failed to establish owned process session for role=$role pid=$pid sid=${sid:-missing}"
    return 1
  fi
  printf '%s\t%s\t%s\t%s\n' "$role" "$pid" "$sid" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$SESSION_OWNERSHIP_FILE"
  printf '%s\t%s\t%s\t%s\n' "$role" "$pid" "$sid" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$ACTIVE_SESSION_OWNERSHIP_FILE"
  log "owned_session role=$role pid=$pid sid=$sid"
  RECORDED_SID=$sid
}

terminate_unrecorded_process() {
  local role=$1
  local pid=$2
  local pgid

  pgid=$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d '[:space:]')
  if [[ "$pgid" == "$pid" ]]; then
    cleanup_group "$role" "$pid" "$pgid" yes || true
  else
    cleanup_log "role=$role pid=$pid pgid=${pgid:-missing} action=TERM-unrecorded"
    kill -TERM "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  fi
}

start_load() {
  local cpu_count=$1
  local workers=0

  case "$STRESS_PROFILE" in
    residual-tail) workers=$((cpu_count * 12)); ((workers > 64)) && workers=64 ;;
    moderate) workers=$((cpu_count * 2)); ((workers > 16)) && workers=16 ;;
    none) workers=0 ;;
  esac
  printf 'cpu_count=%s\nstress_workers=%s\n' "$cpu_count" "$workers" >> "$ARTIFACT_DIR/metadata.txt"
  log "stress_profile=$STRESS_PROFILE cpu_count=$cpu_count workers=$workers"
  ((workers > 0)) || return 0

  # Variables in this single-quoted program expand inside the owned Bash group.
  # shellcheck disable=SC2016
  setsid bash -c '
    workers=$1
    for ((worker = 1; worker <= workers; worker++)); do
      bash -c "while :; do :; done" &
    done
    wait
  ' load "$workers" &
  LOAD_PID=$!
  if ! record_group load "$LOAD_PID"; then
    terminate_unrecorded_process load "$LOAD_PID"
    LOAD_PID=
    return 1
  fi
  LOAD_PGID=$RECORDED_PGID
}

start_sampler() {
  local samples_file=$1

  # Variables in this single-quoted program expand inside the owned Bash group.
  # shellcheck disable=SC2016
  setsid bash -c '
    samples_file=$1
    while :; do
      {
        printf "sample_at=%s\n" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        printf "uptime_seconds=%s\n" "$SECONDS"
        printf "loadavg="
        cat /proc/loadavg
        free -m
        ps -eo pid,ppid,pgid,sid,stat,pcpu,pmem,etimes,comm,args --sort=-pcpu | head -80
        printf "sample_end\n"
      } | tee -a "$samples_file"
      sleep 5
    done
  ' sampler "$samples_file" &
  SAMPLER_PID=$!
  if ! record_group sampler "$SAMPLER_PID"; then
    terminate_unrecorded_process sampler "$SAMPLER_PID"
    SAMPLER_PID=
    return 1
  fi
  SAMPLER_PGID=$RECORDED_PGID
}

run_repetition() {
  local repetition=$1
  local timeout_seconds=$2
  local run_log
  local survivor_evidence
  local started_at=$SECONDS
  local status
  shift 2
  local -a command=("$@")

  run_log=$(printf '%s/run-%03d.log' "$ARTIFACT_DIR" "$repetition")
  printf 'run=%s\tstarted_at=%s\ttimeout_seconds=%s\n' \
    "$repetition" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$timeout_seconds" \
    >> "$ARTIFACT_DIR/campaign-status.tsv"
  {
    printf 'run=%s command=' "$repetition"
    printf '%q ' "${command[@]}"
    printf '\n'
  } >> "$ARTIFACT_DIR/commands.txt"
  log "run=$repetition stage=test-start timeout_seconds=$timeout_seconds"

  # Variables in this single-quoted program expand inside the owned Bash group.
  # shellcheck disable=SC2016
  setsid bash -c '
    set -o pipefail
    subject_dir=$1
    run_log=$2
    timeout_seconds=$3
    shift 3
    cd "$subject_dir"
    timeout --signal=TERM --kill-after=30 "${timeout_seconds}s" "$@" 2>&1 | tee "$run_log"
  ' test "$SUBJECT_DIR" "$run_log" "$timeout_seconds" "${command[@]}" &
  TEST_PID=$!
  if ! record_group test "$TEST_PID"; then
    terminate_unrecorded_process test "$TEST_PID"
    TEST_PID=
    return 1
  fi
  TEST_PGID=$RECORDED_PGID
  if ! record_session test "$TEST_PID"; then
    terminate_unrecorded_process test "$TEST_PID"
    TEST_PID=
    TEST_PGID=
    return 1
  fi
  TEST_SID=$RECORDED_SID
  wait "$TEST_PID"
  status=$?
  survivor_evidence=$(printf '%s/run-%03d-session-survivors.tsv' "$ARTIFACT_DIR" "$repetition")
  verify_and_cleanup_session test "$TEST_PID" "$TEST_SID" "$survivor_evidence" || status=1
  TEST_SID=
  cleanup_group test "$TEST_PID" "$TEST_PGID" no || status=1
  TEST_PID=
  TEST_PGID=

  printf 'run=%s\tfinished_at=%s\telapsed_seconds=%s\texit_status=%s\n' \
    "$repetition" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$((SECONDS - started_at))" "$status" \
    >> "$ARTIFACT_DIR/campaign-status.tsv"
  log "run=$repetition stage=test-finish elapsed_seconds=$((SECONDS - started_at)) exit_status=$status"
  return "$status"
}

main() {
  local status=0
  local cpu_count campaign_deadline remaining_seconds effective_timeout run
  local -a test_command

  while (($# > 0)); do
    case "$1" in
      --subject-dir) SUBJECT_DIR=${2-}; shift 2 ;;
      --artifact-dir) ARTIFACT_DIR=${2-}; shift 2 ;;
      --subject-sha) SUBJECT_SHA=${2-}; shift 2 ;;
      --test-target) TEST_TARGET=${2-}; shift 2 ;;
      --repetitions) REPETITIONS=${2-}; shift 2 ;;
      --stress-profile) STRESS_PROFILE=${2-}; shift 2 ;;
      --validate-only) MODE=validate; shift ;;
      --cleanup-only) MODE=cleanup; shift ;;
      --help|-h) usage; return 0 ;;
      *) printf 'unknown argument: %s\n' "$1" >&2; usage >&2; return 2 ;;
    esac
  done

  if [[ -z "$ARTIFACT_DIR" ]]; then
    printf '%s\n' '--artifact-dir is required' >&2
    return 2
  fi
  mkdir -p "$ARTIFACT_DIR"
  ARTIFACT_DIR=$(cd "$ARTIFACT_DIR" && pwd)
  CLEANUP_LOG="$ARTIFACT_DIR/cleanup.log"
  OWNERSHIP_FILE="$ARTIFACT_DIR/owned-pgids.tsv"
  ACTIVE_OWNERSHIP_FILE="$ARTIFACT_DIR/active-pgids.tsv"
  SESSION_OWNERSHIP_FILE="$ARTIFACT_DIR/owned-sessions.tsv"
  ACTIVE_SESSION_OWNERSHIP_FILE="$ARTIFACT_DIR/active-sessions.tsv"
  touch "$OWNERSHIP_FILE" "$ACTIVE_OWNERSHIP_FILE" "$SESSION_OWNERSHIP_FILE" \
    "$ACTIVE_SESSION_OWNERSHIP_FILE" "$CLEANUP_LOG"

  if [[ "$MODE" == cleanup ]]; then
    cleanup_log "external_cleanup=start"
    cleanup_recorded_sessions || status=1
    cleanup_recorded_groups || status=1
    cleanup_log "external_cleanup=finish status=$status"
    return "$status"
  fi

  trap 'finalize $?' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP

  validate_inputs || return $?
  if [[ "$MODE" == validate ]]; then
    cleanup_log "validation_only post_clean=no_processes_started"
    return 0
  fi
  if [[ -z "$SUBJECT_DIR" || ! -x "$SUBJECT_DIR/test.sh" ]]; then
    log "subject checkout must contain an executable test.sh: ${SUBJECT_DIR:-missing}"
    return 2
  fi
  validate_linux_runner || return 2
  SUBJECT_DIR=$(cd "$SUBJECT_DIR" && pwd)

  RUN_TIMEOUT_SECONDS=${BOTSTER_LOADED_RUN_TIMEOUT_SECONDS:-$DEFAULT_RUN_TIMEOUT_SECONDS}
  CAMPAIGN_TIMEOUT_SECONDS=${BOTSTER_LOADED_CAMPAIGN_TIMEOUT_SECONDS:-$DEFAULT_CAMPAIGN_TIMEOUT_SECONDS}
  if [[ ! "$RUN_TIMEOUT_SECONDS" =~ ^[0-9]+$ ]] || ((RUN_TIMEOUT_SECONDS < 5 || RUN_TIMEOUT_SECONDS > 1800)); then
    log "invalid BOTSTER_LOADED_RUN_TIMEOUT_SECONDS: expected 5-1800"
    return 2
  fi
  if [[ ! "$CAMPAIGN_TIMEOUT_SECONDS" =~ ^[0-9]+$ ]] || ((CAMPAIGN_TIMEOUT_SECONDS < RUN_TIMEOUT_SECONDS || CAMPAIGN_TIMEOUT_SECONDS > 20400)); then
    log "invalid BOTSTER_LOADED_CAMPAIGN_TIMEOUT_SECONDS: expected run timeout through 20400"
    return 2
  fi

  case "$TEST_TARGET" in
    lifecycle-suite)
      test_command=(./test.sh --test hub_daemon_lifecycle_test -- --nocapture)
      ;;
    focused-stalled-attach)
      test_command=(./test.sh --test hub_daemon_lifecycle_test stalled_attach_stdout_does_not_block_other_daemon_commands -- --exact --nocapture)
      ;;
    focused-fast-exit-attach-diagnostic)
      test_command=(./test.sh --test hub_daemon_lifecycle_test fast_exit_attach_diagnostic_records_subscription_event_order -- --exact --nocapture)
      ;;
    focused-oversized-webrtc)
      test_command=(./test.sh --test hub_daemon_lifecycle_test local_webrtc_chunks_oversized_encrypted_daemon_response -- --exact --nocapture)
      ;;
    focused-cli-smoke)
      test_command=(./test.sh --test hub_daemon_lifecycle_test cli_smoke_proves_local_runtime_daemon_package_app_session_and_webrtc -- --exact --nocapture)
      ;;
  esac

  touch "$ARTIFACT_DIR/campaign-status.tsv" "$ARTIFACT_DIR/commands.txt"
  printf 'started_at=%s\nrun_timeout_seconds=%s\ncampaign_timeout_seconds=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$RUN_TIMEOUT_SECONDS" "$CAMPAIGN_TIMEOUT_SECONDS" \
    >> "$ARTIFACT_DIR/campaign-summary.txt"

  cpu_count=$(nproc)
  start_load "$cpu_count" || return 1
  start_sampler "$ARTIFACT_DIR/resource-samples.log" || return 1

  campaign_deadline=$((SECONDS + CAMPAIGN_TIMEOUT_SECONDS))
  for ((run = 1; run <= 10#$REPETITIONS; run++)); do
    remaining_seconds=$((campaign_deadline - SECONDS))
    if ((remaining_seconds < 5)); then
      log "campaign deadline reached before run=$run"
      return 124
    fi
    effective_timeout=$RUN_TIMEOUT_SECONDS
    ((remaining_seconds < effective_timeout)) && effective_timeout=$remaining_seconds
    run_repetition "$run" "$effective_timeout" "${test_command[@]}"
    status=$?
    if ((status != 0)); then
      log "stopping at first red run=$run exit_status=$status"
      return "$status"
    fi
  done

  return 0
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
