#!/bin/sh
# Run one cargo build shape and record the artifacts Cargo reports for it.
#
# Usage: script/cargo-recorded <shape-name> <cargo arguments...>
#
# Status lines and diagnostics still reach stderr as usual
# (--message-format=json-render-diagnostics renders them there). Cargo's JSON
# artifact messages, which list fresh artifacts too, go to
# target/.gate-artifacts/<shape-name>.json, replacing that shape's previous
# record, and the hashes of the binaries and examples it uplifted go to
# <shape-name>.uplifted. script/prune-target keeps exactly the artifacts these
# records name.
# Only build-only commands belong here: `cargo test` must pass --no-run, since
# a running test binary writes to stdout.
set -eu

[ "$#" -ge 2 ] || { echo "usage: script/cargo-recorded <shape-name> <cargo arguments...>" >&2; exit 2; }
shape=$1
shift
case "$shape" in
  *[!A-Za-z0-9_-]*) echo "cargo-recorded: shape name must be [A-Za-z0-9_-]: $shape" >&2; exit 2 ;;
esac

records="${CARGO_TARGET_DIR:-target}/.gate-artifacts"
mkdir -p "$records"
partial="$records/$shape.json.partial"
# Replace the record only after cargo succeeds, so a failed build keeps the
# previous shape's record.
cargo "$@" --message-format=json-render-diagnostics >"$partial"

# Cargo reports a binary or an example by its unhashed uplifted path
# (target/debug/<name>, target/debug/examples/<name>), a copy of the hashed
# artifact <name>-<hash> in deps/ or examples/. Shapes that build the same
# binary share that path, and it holds the copy of whichever shape built last,
# so the hash is resolved now, while it holds this shape's copy (Cargo
# re-uplifts fresh artifacts too): the hashed file with the same bytes. A path
# that matches no hashed file is recorded as unresolved, and prune-target then
# prunes nothing.
node --input-type=module - "$partial" "$records/$shape.uplifted.partial" <<'NODE'
import { readFileSync, readdirSync, statSync, existsSync, writeFileSync } from "node:fs";
import { join, basename, dirname } from "node:path";
import { spawnSync } from "node:child_process";

const [record, out] = process.argv.slice(2);
const hashOf = (name) => (name.match(/-([0-9a-f]{16})(?:\.|$)/) || [])[1];
const resolve = (file) => {
  const stem = basename(file);
  const names = [stem, stem.replace(/-/g, "_")];
  const size = statSync(file).size;
  const target = basename(dirname(file)) === "examples" ? dirname(dirname(file)) : dirname(file);
  for (const dir of [join(target, "deps"), join(target, "examples")]) {
    if (!existsSync(dir)) continue;
    for (const name of readdirSync(dir)) {
      const hash = hashOf(name);
      if (!hash || !names.some((n) => name === `${n}-${hash}`)) continue;
      const path = join(dir, name);
      if (statSync(path).size !== size) continue;
      if (spawnSync("cmp", ["-s", file, path]).status === 0) return hash;
    }
  }
  return undefined;
};
const lines = [];
for (const line of readFileSync(record, "utf8").split("\n")) {
  if (!line.startsWith("{")) continue;
  const message = JSON.parse(line);
  if (message.reason !== "compiler-artifact") continue;
  for (const file of new Set([...(message.filenames ?? []), message.executable].filter(Boolean))) {
    if (hashOf(basename(file)) || hashOf(basename(dirname(file)))) continue;
    if (!existsSync(file)) {
      lines.push(`unresolved ${file}`);
      continue;
    }
    const hash = resolve(file);
    lines.push(hash ? `${hash} ${file}` : `unresolved ${file}`);
  }
}
writeFileSync(out, lines.map((line) => `${line}\n`).join(""));
NODE
mv "$records/$shape.uplifted.partial" "$records/$shape.uplifted"
mv "$partial" "$records/$shape.json"
