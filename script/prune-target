#!/bin/sh
# Remove stale build artifacts from target/debug while keeping everything the
# gate's own cargo build shapes use.
#
# Cargo keeps one hashed copy of every artifact for each distinct invocation
# shape (command, package selection, features, profile, toolchain) and never
# removes old ones, so a long-lived worktree grows to many times one build.
# Every gate build runs through script/cargo-recorded, which saves the JSON
# artifact messages Cargo prints for that shape (fresh artifacts included) to
# target/.gate-artifacts/. This script keeps every artifact hash those records
# name and removes everything else under target/debug/deps, target/debug/build
# and target/debug/.fingerprint, except check-only metadata (a .rmeta with no
# .rlib, from clippy or check), which is small and serves writers' clippy runs.
#
# It never runs cargo, so it never compiles. With no records it prunes nothing
# and exits 3. test.sh runs it as its last step, which only a successful gate
# reaches; a failed gate prunes nothing, so the evidence stays.
#
# Not touched: target/managed-install-proof (one shape, rebuilt in place by
# its test), and anything outside target/debug. target/debug/incremental is
# removed: gates build with CARGO_INCREMENTAL=0, so it is only a cache for
# incremental dev builds, and a later incremental build recreates it.
#
# Usage: script/prune-target [--dry-run]
set -eu

dry_run=0
case "${1-}" in
  --dry-run) dry_run=1 ;;
  "") ;;
  *) echo "usage: script/prune-target [--dry-run]" >&2; exit 2 ;;
esac

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
target=target/debug
[ -d "$target/deps" ] || { echo "prune-target: no $target/deps; nothing to prune"; exit 0; }

records="$target/../.gate-artifacts"
if ! ls "$records"/*.json >/dev/null 2>&1; then
  echo "prune-target: no recorded gate artifacts under $records; pruning nothing" >&2
  exit 3
fi

node --input-type=module - "$records" "$target" "$dry_run" <<'NODE'
import { readFileSync, readdirSync, statSync, rmSync, existsSync } from "node:fs";
import { join, basename, dirname } from "node:path";
import { spawnSync } from "node:child_process";

const [recordsDir, target, dryRunArg] = process.argv.slice(2);
const dryRun = dryRunArg === "1";
const hashOf = (name) => (name.match(/-([0-9a-f]{16})(?:\.|$)/) || [])[1];

const keep = new Set();
// Cargo reports a binary or an example by its uplifted, unhashed path
// (target/debug/<name>, target/debug/examples/<name>). The uplift is a copy
// (or a hard link) of the hashed artifact <name>-<hash> in deps/ or examples/;
// find the hashed file with the same size and the same bytes.
const hashedCandidates = (file) => {
  const stem = basename(file);
  const names = [stem, stem.replace(/-/g, "_")];
  const size = statSync(file).size;
  const found = [];
  for (const dir of [join(target, "deps"), join(target, "examples")]) {
    if (!existsSync(dir)) continue;
    for (const name of readdirSync(dir)) {
      const hash = hashOf(name);
      if (!hash || !names.some((n) => name === `${n}-${hash}`)) continue;
      const path = join(dir, name);
      if (statSync(path).size === size) found.push([path, hash]);
    }
  }
  return found;
};
const hashOfArtifact = (file) => {
  const direct = hashOf(basename(file)) ?? hashOf(basename(dirname(file)));
  if (direct) return direct;
  if (!existsSync(file)) return undefined;
  for (const [path, hash] of hashedCandidates(file)) {
    if (spawnSync("cmp", ["-s", file, path]).status === 0) return hash;
  }
  return undefined;
};
const lines = readdirSync(recordsDir)
  .filter((name) => name.endsWith(".json"))
  .flatMap((name) => readFileSync(join(recordsDir, name), "utf8").split("\n"));
for (const line of lines) {
  if (!line.startsWith("{")) continue;
  const message = JSON.parse(line);
  if (message.reason === "compiler-artifact") {
    // A build script's artifact is build/<pkg>-<hash>/build-script-build: the
    // hash is on its directory. A bin or example is reported unhashed.
    for (const file of [...(message.filenames ?? []), message.executable].filter(Boolean)) {
      const hash = hashOfArtifact(file);
      if (hash) keep.add(hash);
    }
  } else if (message.reason === "build-script-executed" && message.out_dir) {
    const hash = hashOf(basename(join(message.out_dir, "..")));
    if (hash) keep.add(hash);
  }
}
if (keep.size === 0) {
  console.error("prune-target: cargo reported no artifacts; pruning nothing.");
  process.exit(3);
}

const deps = join(target, "deps");
const depFiles = readdirSync(deps);
// Check-only metadata: a hash that has a .rmeta but no .rlib and no other file.
const byHash = new Map();
for (const name of depFiles) {
  const hash = hashOf(name);
  if (!hash) continue;
  if (!byHash.has(hash)) byHash.set(hash, []);
  byHash.get(hash).push(name);
}
const checkOnly = new Set(
  [...byHash].filter(([, names]) =>
    names.some((name) => name.endsWith(".rmeta")) &&
    names.every((name) => name.endsWith(".rmeta") || name.endsWith(".d"))
  ).map(([hash]) => hash)
);
const retained = (hash) => !hash || keep.has(hash) || checkOnly.has(hash);

let files = 0;
let bytes = 0;
const sizeOf = (path) => {
  const stat = statSync(path);
  if (!stat.isDirectory()) return stat.size;
  return readdirSync(path).reduce((sum, name) => sum + sizeOf(join(path, name)), 0);
};
const remove = (path) => {
  const size = sizeOf(path);
  files += 1;
  bytes += size;
  if (!dryRun) rmSync(path, { recursive: true, force: true });
};
for (const name of depFiles) {
  if (!retained(hashOf(name))) remove(join(deps, name));
}
for (const dir of ["build", ".fingerprint", "examples"]) {
  const path = join(target, dir);
  if (!existsSync(path)) continue;
  for (const name of readdirSync(path)) {
    if (!retained(hashOf(name))) remove(join(path, name));
  }
}
const incremental = join(target, "incremental");
if (existsSync(incremental)) remove(incremental);
const gib = (bytes / 1073741824).toFixed(2);
console.log(`prune-target: ${dryRun ? "would remove" : "removed"} ${files} entries (${gib} GiB of files) under ${target}; kept ${keep.size} artifact hashes`);
NODE
