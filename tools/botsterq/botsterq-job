#!/usr/bin/env python3
"""botsterq job supervisor: runs one queued command and leads its process group.

Usage: botsterq-job <pidfile> <marker> <joblock> <owner-pid> <grace-seconds> -- <command...>

task-spooler starts this as the job, in a new process group that this process
leads. It exits only when every other member of that group is gone, so the
queue slot is never released while any of the job's processes still run.

- Start: under the job lock it either consumes a cancel marker (and exits 130
  without running anything) or publishes its pid, which is the group id. A job
  whose `botsterq run` process is gone does not start.
- Run: the command runs as a child in this group, under `nice -n 10`.
- Cancel: SIGTERM (or SIGINT, SIGHUP) to this process sends SIGTERM to every
  other group member, and SIGKILL to any member left when the grace ends.
- End: after the command exits (or after cancelling), it waits on process-exit
  events (kqueue NOTE_EXIT on macOS, pidfd on Linux) until the group is empty,
  re-enumerating members after each round so a process forked meanwhile is
  still waited for. It then exits with the command's status, or 130 when
  cancelled.
"""

import fcntl
import os
import select
import signal
import subprocess
import sys
import time


def group_members(pgid):
    """Live processes in group pgid other than this one and the census's own
    `ps` (which runs in this group), zombies excluded."""
    census = subprocess.Popen(["ps", "-axo", "pid=,pgid=,stat="], stdout=subprocess.PIPE, text=True)
    out, _ = census.communicate()
    if census.returncode != 0:
        raise RuntimeError(f"ps census exited {census.returncode}")
    members = []
    for line in out.splitlines():
        parts = line.split()
        if len(parts) < 3:
            continue
        pid, group, stat = int(parts[0]), int(parts[1]), parts[2]
        if group == pgid and pid not in (os.getpid(), census.pid) and "Z" not in stat:
            members.append(pid)
    return members


def wait_events(pids, deadline, wakeup):
    """Block until one of pids exits, a signal arrives (a byte on the wakeup
    pipe), or deadline passes. Events only: kqueue NOTE_EXIT on macOS, pidfd on
    Linux. A pid that is already gone returns at once."""
    timeout = None if deadline is None else max(0.0, deadline - time.monotonic())
    if hasattr(select, "kqueue"):
        queue = select.kqueue()
        queue.control([select.kevent(wakeup, filter=select.KQ_FILTER_READ, flags=select.KQ_EV_ADD)], 0, 0)
        for pid in pids:
            try:
                queue.control([select.kevent(pid, filter=select.KQ_FILTER_PROC, flags=select.KQ_EV_ADD,
                                             fflags=select.KQ_NOTE_EXIT)], 0, 0)
            except OSError:
                queue.close()
                return  # already exited (or a zombie): the caller re-checks
        queue.control(None, 1, timeout)
        queue.close()
        return
    poller = select.poll()
    poller.register(wakeup, select.POLLIN)
    fds = []
    try:
        for pid in pids:
            try:
                fd = os.pidfd_open(pid)
            except ProcessLookupError:
                return
            fds.append(fd)
            poller.register(fd, select.POLLIN)
        poller.poll(None if timeout is None else int(timeout * 1000))
    finally:
        for fd in fds:
            os.close(fd)


def main():
    pidfile, marker, joblock, owner, grace = sys.argv[1:6]
    if sys.argv[6] != "--":
        sys.exit("botsterq-job: usage error")
    command = sys.argv[7:]
    grace = float(grace)
    pgid = os.getpgrp()

    hold = os.environ.get("BOTSTERQ_TEST_BEFORE_PIDFILE")
    if hold:
        with open(hold) as fifo:
            fifo.read(1)
    try:
        os.kill(int(owner), 0)
    except ProcessLookupError:
        sys.exit(130)  # its `botsterq run` is gone: do not start
    # Under the job lock: a cancel that came first left a marker (consume it and
    # do not start); otherwise publish this group for any later cancel.
    with open(joblock, "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if os.path.exists(marker):
            os.unlink(marker)
            sys.exit(130)
        with open(pidfile, "w") as published:
            published.write(f"{pgid}\n")
    hold = os.environ.get("BOTSTERQ_TEST_AFTER_PIDFILE")
    if hold:
        with open(hold) as fifo:
            fifo.read(1)

    # Signals only set state and wake the event wait (set_wakeup_fd); the loop
    # below reacts, so a signal during a wait recomputes its deadline.
    wakeup_read, wakeup_write = os.pipe()
    os.set_blocking(wakeup_write, False)
    os.set_blocking(wakeup_read, False)
    signal.set_wakeup_fd(wakeup_write)
    requested = {"cancel": False}

    def on_cancel(signum, frame):
        requested["cancel"] = True

    cancel_signals = {signal.SIGTERM, signal.SIGINT, signal.SIGHUP}
    for signum in cancel_signals:
        signal.signal(signum, on_cancel)
    hold = os.environ.get("BOTSTERQ_TEST_BEFORE_SPAWN")
    if hold:
        with open(hold) as fifo:
            fifo.read(1)

    # Start the command with cancel signals blocked, so a cancel either comes
    # before the check below (the command never starts) or is handled after the
    # child exists. The child unblocks them before it execs.
    signal.pthread_sigmask(signal.SIG_BLOCK, cancel_signals)
    if requested["cancel"]:
        sys.exit(130)
    env = dict(os.environ, BOTSTERQ_JOB=str(pgid))
    child = subprocess.Popen(
        ["nice", "-n", "10", *command],
        env=env,
        preexec_fn=lambda: signal.pthread_sigmask(signal.SIG_UNBLOCK, cancel_signals),
    )
    signal.pthread_sigmask(signal.SIG_UNBLOCK, cancel_signals)

    def signal_all(signum):
        for pid in group_members(pgid):
            try:
                os.kill(pid, signum)
            except ProcessLookupError:
                pass

    status = None
    cancelled = False
    # Escalation after a cancel, or after the command leaves processes behind:
    # "wait" (grace for leftovers to exit), then "term", then "kill".
    phase = None
    deadline = None
    while True:
        if status is None and child.poll() is not None:
            status = child.returncode
        hold = os.environ.pop("BOTSTERQ_TEST_AFTER_POLL", None)
        if hold:
            with open(hold) as fifo:
                fifo.read(1)
        if requested["cancel"] and not cancelled:
            cancelled = True
            signal_all(signal.SIGTERM)
            phase, deadline = "term", time.monotonic() + grace
        members = group_members(pgid)
        if not members and status is not None:
            break
        if status is not None and phase is None and members:
            phase, deadline = "wait", time.monotonic() + grace
        if deadline is not None and time.monotonic() >= deadline:
            if phase == "wait":
                print(f"botsterq: the job left {len(members)} process(es) running: {members}; stopping them",
                      file=sys.stderr)
                signal_all(signal.SIGTERM)
                phase, deadline = "term", time.monotonic() + grace
            elif phase == "term":
                signal_all(signal.SIGKILL)
                phase, deadline = "kill", time.monotonic() + grace
            else:
                print(f"botsterq: process(es) {members} survived SIGKILL", file=sys.stderr)
                sys.exit(137)
            continue
        # The census omits zombies, so an exited but unreaped command is not a
        # member; wait on it too, or its exit would not end the wait when other
        # members (processes it left behind) are still running.
        wait_events(members if status is not None else [*members, child.pid], deadline, wakeup_read)
        try:
            os.read(wakeup_read, 512)
        except BlockingIOError:
            pass

    if cancelled:
        sys.exit(130)
    sys.exit(status if status >= 0 else 128 - status)


if __name__ == "__main__":
    main()
