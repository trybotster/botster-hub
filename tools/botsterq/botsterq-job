#!/usr/bin/env python3
"""botsterq job supervisor: runs one queued command and holds its queue slot
until every process of the command's process group is gone.

Usage: botsterq-job <pidfile> <marker> <joblock> <owner-pid> <grace-seconds> <deadline-seconds> -- <command...>

task-spooler starts this as the job and releases the slot when it exits, so it
exits only once the command's group is proved absent: killpg(group, 0) fails
with ESRCH. That is the kernel's answer, zombies included (macOS answers EPERM
for a group of zombies only, which counts as present). Nothing else, not a
failed census, a failed watch or a process that survives SIGKILL, ends the job.

- Start: under the job lock it either consumes a cancel marker (and exits 130
  without running anything) or publishes its pid for a later cancel. A job
  whose `botsterq run` process is gone does not start.
- Run: the command runs as a child under `nice -n 10`, in a new process group
  of its own (the command's pid), so the group holds only the command and what
  it starts. After the start, the pid file's second line is that group.
- Cancel: SIGTERM (or SIGINT, SIGHUP) to this process sends SIGTERM to the
  command's group, and SIGKILL when the grace ends.
- End: after the command exits (or after a cancel), leftovers get the grace,
  then SIGTERM, then SIGKILL, and then as long as they take: a process that
  survives SIGKILL keeps the slot, with a warning, until it is gone. The exit
  status is the command's, or 130 when cancelled.
- Deadline: a positive <deadline-seconds> (0 means none) bounds the command's
  run time from its start (queue wait is not counted). At expiry it prints
  "deadline expired" and stops the group like a cancel (SIGTERM, SIGKILL when
  the grace ends); the exit status is then 124 (a cancel, 130, wins). The
  deadline is a timer that ends the job, so callers set it as a hang guard.
- Waiting uses process-exit events (kqueue NOTE_EXIT on macOS, pidfd on Linux)
  on the members a `ps` census names, plus the command itself until it is
  reaped.
- Degraded mode, the one exception to waiting on events: when no event source
  exists (the census or a watch failed at any step, or the group holds only
  processes the census cannot name, such as zombies not yet reaped), it polls
  for absence every RECHECK_SECONDS. That is a progress poll, not a give-up
  deadline: it never ends the job, only notices sooner that the group is gone.
- An unexpected error in the loop itself still ends the job only when the group
  is gone: the command runs on, is reaped, a cancel still escalates, and the
  slot is held meanwhile (the same progress poll).
- Needs Python 3.9 or later (`botsterq run` checks before admission).
"""

import atexit
import errno
import fcntl
import os
import select
import signal
import subprocess
import sys
import time

# Progress-poll interval of the degraded mode (see above).
RECHECK_SECONDS = 0.1


class WatchError(Exception):
    """An exit watch failed for a reason other than the process being gone."""


def group_absent(pgid):
    """True only when the kernel reports no process in group pgid."""
    try:
        os.killpg(pgid, 0)
    except ProcessLookupError:
        return True
    except PermissionError:
        return False  # only zombies are left (macOS): still present
    return False


def signal_group(pgid, signum):
    if signum == signal.SIGKILL and os.environ.get("BOTSTERQ_TEST_NO_SIGKILL"):
        return  # test hook: stands in for a process that survives SIGKILL
    try:
        os.killpg(pgid, signum)
    except (ProcessLookupError, PermissionError):
        pass  # gone, or only zombies left


def group_members(pgid):
    """Live processes in group pgid, zombies excluded. Raises when ps fails."""
    if os.environ.get("BOTSTERQ_TEST_FAIL_CENSUS"):
        raise RuntimeError("ps census failed (test hook)")
    census = subprocess.run(["ps", "-axo", "pid=,pgid=,stat="], stdout=subprocess.PIPE, text=True)
    if census.returncode != 0:
        raise RuntimeError(f"ps census exited {census.returncode}")
    members = []
    for line in census.stdout.splitlines():
        parts = line.split()
        if len(parts) < 3:
            continue
        pid, group, stat = int(parts[0]), int(parts[1]), parts[2]
        if group == pgid and "Z" not in stat:
            members.append(pid)
    return members


def wait_events(pids, deadline, wakeup):
    """Block until one of pids exits, a signal arrives (a byte on the wakeup
    pipe), or deadline passes. A pid that is already gone (or a zombie, which
    kqueue refuses) returns at once. Every other failure, at any step (creating
    the kqueue or poll object, registering, waiting), raises WatchError."""
    timeout = None if deadline is None else max(0.0, deadline - time.monotonic())
    if hasattr(select, "kqueue"):
        try:
            queue = select.kqueue()
        except OSError as error:
            raise WatchError(f"kqueue creation: {error}") from error
        try:
            queue.control([select.kevent(wakeup, filter=select.KQ_FILTER_READ, flags=select.KQ_EV_ADD)], 0, 0)
            for pid in pids:
                try:
                    queue.control([select.kevent(pid, filter=select.KQ_FILTER_PROC, flags=select.KQ_EV_ADD,
                                                 fflags=select.KQ_NOTE_EXIT)], 0, 0)
                except OSError as error:
                    if error.errno == errno.ESRCH:
                        return  # already exited: the caller re-checks
                    raise
            queue.control(None, 1, timeout)
        except OSError as error:
            raise WatchError(f"kqueue: {error}") from error
        finally:
            queue.close()
        return
    fds = []
    try:
        poller = select.poll()
        poller.register(wakeup, select.POLLIN)
        for pid in pids:
            try:
                fd = os.pidfd_open(pid)
            except ProcessLookupError:
                return
            fds.append(fd)
            poller.register(fd, select.POLLIN)
        poller.poll(None if timeout is None else int(timeout * 1000))
    except OSError as error:
        raise WatchError(f"pidfd/poll: {error}") from error
    finally:
        for fd in fds:
            os.close(fd)


def recheck_wait(deadline, recheck, wakeup):
    """Degraded mode, when no exit event can be watched: wait for a signal until
    the earlier of deadline and recheck, so the caller can poll absence again.
    This is a progress poll, the one exception to waiting on events; it runs
    only while the census or the watch is failing, or while the group holds
    only processes the census cannot name (zombies awaiting their reaper)."""
    until = recheck if deadline is None else min(deadline, recheck)
    remaining = max(0.0, until - time.monotonic())
    try:
        select.select([wakeup], [], [], remaining)
    except (OSError, ValueError):
        # Even select failed: sleep instead (a signal still ends the loop's
        # next pass through the requested flag).
        time.sleep(remaining)


def log_event(events, kind, token, info):
    """Append one line to the events log (the command's start or end), so that
    `botsterq audit` can later prove which jobs ran at the same time. One
    O_APPEND write per line; a failure to log never affects the job."""
    try:
        line = "\t".join([kind, f"{time.time():.3f}", token, *info]).replace("\n", " ") + "\n"
        fd = os.open(events, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
        try:
            os.write(fd, line.encode())
        finally:
            os.close(fd)
    except Exception as error:
        # A missing record makes `botsterq audit` blind to this job, so say so
        # (once per line; never fail the job).
        try:
            print(f"botsterq: cannot write the events log ({error}); audit will not see this {kind}",
                  file=sys.stderr, flush=True)
        except Exception:
            pass


def install_test_faults():
    """Test hook: BOTSTERQ_TEST_FAIL_AT names watch boundaries that fail, by
    replacing the real select functions, so the conversion code itself runs:
    kqueue (creation), register (adding a filter), wait (the blocking call),
    fallback (select in the degraded wait), loop (an unexpected error in the
    supervisor loop)."""
    faults = set(filter(None, os.environ.get("BOTSTERQ_TEST_FAIL_AT", "").split(",")))
    real_kqueue = getattr(select, "kqueue", None)

    class FaultyQueue:
        def __init__(self):
            self.queue = real_kqueue()

        def control(self, changelist, max_events, timeout=None):
            if changelist and "register" in faults:
                raise OSError(errno.EBADF, "registration failed (test hook)")
            if changelist is None and "wait" in faults:
                raise OSError(errno.EBADF, "wait failed (test hook)")
            return self.queue.control(changelist, max_events, timeout)

        def close(self):
            self.queue.close()

    def failing_kqueue():
        raise OSError(errno.EMFILE, "too many open files (test hook)")

    def failing_select(*args):
        raise OSError(errno.EBADF, "select failed (test hook)")

    if real_kqueue is not None:
        if "kqueue" in faults:
            select.kqueue = failing_kqueue
        elif faults & {"register", "wait"}:
            select.kqueue = FaultyQueue
    if "fallback" in faults:
        select.select = failing_select
    return faults


def hold_for_test(name):
    hold = os.environ.pop(name, None)
    if hold:
        with open(hold) as fifo:
            fifo.read(1)


def main():
    if len(sys.argv) > 6 and sys.argv[6] == "--":
        # The shape of a `botsterq run` from before the deadline existed: no
        # run limit (an install must not break a run that is already waiting).
        pidfile, marker, joblock, owner, grace = sys.argv[1:6]
        run_limit = "0"
        command = sys.argv[7:]
    else:
        pidfile, marker, joblock, owner, grace, run_limit = sys.argv[1:7]
        if len(sys.argv) < 8 or sys.argv[7] != "--":
            sys.exit("botsterq-job: usage error")
        command = sys.argv[8:]
    grace = float(grace)
    run_limit = float(run_limit)
    pgid = os.getpgrp()

    hold_for_test("BOTSTERQ_TEST_BEFORE_PIDFILE")
    try:
        os.kill(int(owner), 0)
    except ProcessLookupError:
        sys.exit(130)  # its `botsterq run` is gone: do not start
    # Under the job lock: a cancel that came first left a marker (consume it and
    # do not start); otherwise publish this process for any later cancel.
    with open(joblock, "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if os.path.exists(marker):
            os.unlink(marker)
            sys.exit(130)
        with open(pidfile, "w") as published:
            published.write(f"{pgid}\n")
    hold_for_test("BOTSTERQ_TEST_AFTER_PIDFILE")

    # Signals only set state and wake the event wait (set_wakeup_fd); the loop
    # below reacts, so a signal during a wait recomputes its deadline.
    wakeup_read, wakeup_write = os.pipe()
    os.set_blocking(wakeup_write, False)
    os.set_blocking(wakeup_read, False)
    signal.set_wakeup_fd(wakeup_write)
    requested = {"cancel": False}

    def on_cancel(signum, frame):
        requested["cancel"] = True

    cancel_signals = {signal.SIGTERM, signal.SIGINT, signal.SIGHUP}
    for signum in cancel_signals:
        signal.signal(signum, on_cancel)
    hold_for_test("BOTSTERQ_TEST_BEFORE_SPAWN")

    # Start the command with cancel signals blocked, so a cancel either comes
    # before the check below (the command never starts) or is handled after the
    # child exists. The child unblocks them before it execs. Popen returns only
    # after the exec, so the child's own group exists from here on.
    signal.pthread_sigmask(signal.SIG_BLOCK, cancel_signals)
    if requested["cancel"]:
        sys.exit(130)
    # Job facts for the events log come from `botsterq run`; the command does
    # not need them.
    slots = os.environ.pop("BOTSTERQ_SLOTS", "?")
    exclusive = os.environ.pop("BOTSTERQ_EXCLUSIVE", "?")
    label = os.environ.pop("BOTSTERQ_LABEL", "")
    token = os.path.basename(pidfile).rsplit(".", 1)[0]
    events = os.path.join(os.path.dirname(os.path.dirname(pidfile)), "events.log")
    env = dict(os.environ, BOTSTERQ_JOB=str(pgid))
    def in_child():
        # A process group of its own (Popen's process_group needs Python 3.11).
        os.setpgid(0, 0)
        signal.pthread_sigmask(signal.SIG_UNBLOCK, cancel_signals)

    faults = install_test_faults()
    child = subprocess.Popen(["nice", "-n", "10", *command], env=env, preexec_fn=in_child)
    group = child.pid
    try:
        load = "load=" + "/".join(f"{value:.1f}" for value in os.getloadavg())
    except OSError:
        load = "load=?"
    log_event(events, "start", token, [slots, exclusive, label, load])
    # The end is logged when the group is gone (every exit path leaves through
    # sys.exit), which is when the queue slot is released.
    atexit.register(log_event, events, "end", token, [slots, exclusive, label, ""])
    # The reservation guard starts here: from now on the command may be alive,
    # so no failure below may end this supervisor before the group is gone.
    try:
        if "publish" in faults:
            raise OSError(errno.EIO, "publishing the command group failed (test hook)")
        with open(joblock, "a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            with open(pidfile, "a") as published:
                published.write(f"{group}\n")
        signal.pthread_sigmask(signal.SIG_UNBLOCK, cancel_signals)
        run_deadline = time.monotonic() + run_limit if run_limit > 0 else None
        status, cancelled, expired = supervise(child, group, grace, requested, wakeup_read, faults, run_deadline)
    except Exception as error:
        # Whatever failed, a supervisor exit releases the slot, so it happens
        # only once the group is proved absent. Cancel delivery must be live
        # for the hold, and the diagnostic must not be able to skip it.
        try:
            signal.pthread_sigmask(signal.SIG_UNBLOCK, cancel_signals)
        except BaseException:
            pass
        try:
            if "diagnostic" in faults:
                raise BrokenPipeError(errno.EPIPE, "diagnostic write failed (test hook)")
            print(f"botsterq: supervisor error: {error!r}; holding the slot until group {group} is gone",
                  file=sys.stderr, flush=True)
        except BaseException:
            pass
        status = hold_until_absent(child, group, grace, requested)
        if status is None:
            sys.exit(130)
        sys.exit(status if status >= 0 else 128 - status)
    if cancelled:
        sys.exit(130)
    if expired:
        sys.exit(124)
    sys.exit(status if status >= 0 else 128 - status)


def supervise(child, group, grace, requested, wakeup_read, faults, run_deadline):
    """Run the escalation loop until the kernel reports the group gone.
    Returns (status, cancelled, expired)."""
    warned = set()

    def warn_once(key, text):
        if key not in warned:
            warned.add(key)
            print(f"botsterq: {text}", file=sys.stderr, flush=True)

    status = None
    cancelled = False
    expired = False
    # Escalation after a cancel, or after the command leaves processes behind:
    # "wait" (grace for leftovers to exit), then "term", then "kill", then
    # "held" (survivors of SIGKILL keep the slot until they are gone).
    phase = None
    deadline = None
    while True:
        if "loop" in faults:
            raise RuntimeError("unexpected supervisor error (test hook)")
        if status is None and child.poll() is not None:
            status = child.returncode
        hold_for_test("BOTSTERQ_TEST_AFTER_POLL")
        if requested["cancel"] and not cancelled:
            cancelled = True
            signal_group(group, signal.SIGTERM)
            phase, deadline = "term", time.monotonic() + grace
        if (run_deadline is not None and not expired and not cancelled and status is None
                and time.monotonic() >= run_deadline):
            expired = True
            warn_once("deadline", f"deadline expired: stopping the job's group {group}")
            signal_group(group, signal.SIGTERM)
            phase, deadline = "term", time.monotonic() + grace
        # While the command is unreaped its group exists, so only after that is
        # absence possible.
        if status is not None and group_absent(group):
            break
        if status is not None and phase is None:
            phase, deadline = "wait", time.monotonic() + grace
        try:
            members = group_members(group)
        except Exception as error:
            members = None
            warn_once("census", f"{error}; holding the slot until group {group} is gone")
        if deadline is not None and time.monotonic() >= deadline:
            shown = "unknown (no census)" if members is None else members
            if phase == "wait":
                warn_once("left", f"the job left process(es) running: {shown}; stopping them")
                signal_group(group, signal.SIGTERM)
                phase, deadline = "term", time.monotonic() + grace
            elif phase == "term":
                signal_group(group, signal.SIGKILL)
                phase, deadline = "kill", time.monotonic() + grace
            else:
                warn_once("held", f"process(es) {shown} survived SIGKILL; holding the slot until they are gone")
                phase, deadline = "held", None
            continue
        # The census omits zombies, so an exited but unreaped command is not a
        # member; watch it too, or its exit would not end the wait while other
        # members (processes it left behind) run.
        # The escalation deadline, else the run deadline that has not yet passed.
        wait_until = deadline
        if wait_until is None and run_deadline is not None and not expired and status is None:
            wait_until = run_deadline
        watch = None if members is None else (members if status is not None else [*members, child.pid])
        recheck = time.monotonic() + RECHECK_SECONDS
        if watch:
            try:
                wait_events(watch, wait_until, wakeup_read)
            except WatchError as error:
                warn_once("watch", f"{error}; polling group {group} for absence instead")
                recheck_wait(wait_until, recheck, wakeup_read)
        else:
            # No event source: the census failed, or the group holds only
            # processes it cannot name (zombies awaiting their reaper).
            recheck_wait(wait_until, recheck, wakeup_read)
        try:
            os.read(wakeup_read, 512)
        except OSError:
            pass
    return status, cancelled, expired



def hold_until_absent(child, group, grace, requested):
    """Last resort after an unexpected supervisor error: the command keeps
    running, is reaped when it exits, and a cancel still escalates; the slot is
    held until the kernel reports the group gone. Waits by the same degraded
    progress poll. Returns the command's status, or None when cancelled."""
    kill_at = None
    while True:
        try:
            child.poll()
            if requested["cancel"] and kill_at is None:
                signal_group(group, signal.SIGTERM)
                kill_at = time.monotonic() + grace
            if kill_at is not None and time.monotonic() >= kill_at:
                signal_group(group, signal.SIGKILL)
                kill_at = float("inf")
            if child.returncode is not None and group_absent(group):
                return None if requested["cancel"] else child.returncode
        except Exception:
            pass  # cannot tell: still present
        time.sleep(RECHECK_SECONDS)


if __name__ == "__main__":
    main()
