#!/bin/sh
# Regression tests for botsterq, on a private queue (never the machine queue).
# Usage: tools/botsterq/test-botsterq
set -u

here=$(cd "$(dirname "$0")" && pwd)
Q="$here/botsterq"
work=$(cd "$(mktemp -d "${TMPDIR:-/tmp}/botsterq-test.XXXXXX")" && pwd)
export BOTSTERQ_HOME="$work/home"
export BOTSTERQ_KILL_GRACE=2
failures=0
pass() { echo "PASS $1"; }
fail() { echo "FAIL $1: $2"; failures=$((failures + 1)); }
cleanup() {
  TS_SOCKET="$BOTSTERQ_HOME/queue.sock" ts -K >/dev/null 2>&1 || true
  [ -n "${control:-}" ] && kill "$control" 2>/dev/null
  rm -rf "$work"
}
trap cleanup EXIT
cd "$work"
group_members() { ps -axo pgid= | awk -v g="$1" '$1 == g' | wc -l | tr -d ' '; }
# Wait until a file matching the glob $1 exists (a job's pid file or marker).
await_file() {
  i=0
  until ls $1 >/dev/null 2>&1; do
    i=$((i + 1)); [ "$i" -gt 200 ] && return 1
    # timer: deadline — test-side wait for the job to publish its file.
    perl -e 'select(undef, undef, undef, 0.05)'
  done
}
await_text() {
  i=0
  until grep -q -- "$2" "$1" 2>/dev/null; do
    i=$((i + 1)); [ "$i" -gt 200 ] && return 1
    # timer: deadline — test-side wait for a supervisor warning.
    perl -e 'select(undef, undef, undef, 0.05)'
  done
}
# The pid file's first line is the supervisor's pid; its second, written once
# the command has started, is the command's process group.
supervisor_group() { await_file "$BOTSTERQ_HOME/run/*.pid"; cat "$BOTSTERQ_HOME"/run/*.pid 2>/dev/null | head -1; }
job_group() {
  i=0
  until [ "$(cat "$BOTSTERQ_HOME"/run/*.pid 2>/dev/null | wc -l | tr -d ' ')" -ge 2 ]; do
    i=$((i + 1)); [ "$i" -gt 200 ] && return 1
    # timer: deadline — test-side wait for the job to publish its command group.
    perl -e 'select(undef, undef, undef, 0.05)'
  done
  cat "$BOTSTERQ_HOME"/run/*.pid | sed -n 2p
}
# Wait until the queue shows a job whose label contains $1 in state $2.
await_state() {
  i=0
  until TS_SOCKET="$BOTSTERQ_HOME/queue.sock" ts -l | grep -F -- "$1" | grep -q " $2 "; do
    i=$((i + 1)); [ "$i" -gt 200 ] && return 1
    # timer: deadline — test-side wait for the queue to reflect an admission.
    perl -e 'select(undef, undef, undef, 0.05)'
  done
}

# 1. Exit code, environment, directory, nice, streamed stdout and stderr.
out=$(FOO=bar "$Q" run --label t1 -- sh -c 'echo "cwd=$(pwd) FOO=$FOO nice=$(ps -o nice= -p $$ | tr -d " ")"; echo err >&2; exit 5' 2>&1)
code=$?
[ "$code" = 5 ] && echo "$out" | grep -q "cwd=$work FOO=bar nice=10" && echo "$out" | grep -q '^err$' \
  && pass "exit code, env, cwd, nice, streamed output" || fail "t1" "code=$code out=$out"

# 2. Slot changes: allowed on an empty queue, refused while a job exists.
"$Q" slots 1 >/dev/null && [ "$("$Q" slots)" = 1 ] || fail "slots set" "could not set 1"
"$Q" run --label hold -- sh -c 'sleep 3' >/dev/null 2>&1 &
holder=$!
await_state "hold @" running
if "$Q" slots 2 >/dev/null 2>&1; then fail "slots refuse" "changed while a job ran"; else pass "slots refuse to change while a job runs"; fi
wait "$holder"
"$Q" slots 2 >/dev/null && pass "slots change on an empty queue" || fail "slots change" "refused on an empty queue"

# 3. Exclusive reservation equals the slot count, and slots cannot change under it.
"$Q" run --label ex --exclusive -- sh -c 'sleep 3' >/dev/null 2>&1 &
exj=$!
await_state "ex [exclusive] @" running
if "$Q" slots 3 >/dev/null 2>&1; then fail "exclusive slots" "slots changed under an exclusive job"; else pass "slots cannot change under an exclusive job"; fi
wait "$exj"

# 4. Cancelling a queued job removes it; the running job continues.
"$Q" slots 1 >/dev/null
"$Q" run --label A -- sh -c 'sleep 4; echo A-done' >"$work/A.out" 2>&1 &
A=$!
await_state "A @" running
"$Q" run --label B -- sh -c 'touch "$0/B-ran"' "$work" >/dev/null 2>&1 &
B=$!
await_state "B @" queued
kill -TERM "$B"; wait "$B"; codeB=$?
wait "$A"; codeA=$?
[ "$codeB" = 130 ] && [ ! -e "$work/B-ran" ] && [ "$codeA" = 0 ] && grep -q A-done "$work/A.out" \
  && pass "cancel queued job; running job continues" || fail "cancel queued" "B=$codeB A=$codeA"

# 5. Cancelling a running job whose child ignores SIGTERM after the leader exits.
sleep 300 & control=$!
"$Q" run --label R -- sh -c 'sh -c "trap \"\" TERM; sleep 60" & trap "exit 0" TERM; wait' >/dev/null 2>"$work/R.err" &
R=$!
await_state "R @" running
g=$(job_group)
kill -TERM "$R"; wait "$R"; codeR=$?
[ "$codeR" = 130 ] && [ -n "$g" ] && [ "$(group_members "$g")" = 0 ] && kill -0 "$control" 2>/dev/null \
  && pass "cancel escalates to SIGKILL for a TERM-ignoring child (run exit 130); control untouched" \
  || fail "resistant descendant" "run=$codeR group=$g members=$(group_members "$g") stderr=$(cat "$work/R.err")"

# 6. Start race, before the pid file: the job has started but not published
#    its pid when cancel arrives. It must not run its command.
mkfifo "$work/before"
BOTSTERQ_TEST_BEFORE_PIDFILE="$work/before" "$Q" run --label P1 -- sh -c 'touch "$0/P1-ran"' "$work" >/dev/null 2>&1 &
P1=$!
await_state "P1 @" running
kill -TERM "$P1"
# Release the job only once the cancel has registered, which pins the
# interleaving: cancel strictly before the job publishes its pid.
await_file "$BOTSTERQ_HOME/run/*.cancelled"
printf x >"$work/before"
wait "$P1"; codeP1=$?
TS_SOCKET="$BOTSTERQ_HOME/queue.sock" ts -w >/dev/null 2>&1
[ ! -e "$work/P1-ran" ] && pass "cancel before pid publication: command never runs (run exit $codeP1)" \
  || fail "race before pid" "the command ran"

# 7. Start race, after the pid file and before the marker check: cancel sees
#    the pid and stops the group; the command never runs.
mkfifo "$work/after"
BOTSTERQ_TEST_AFTER_PIDFILE="$work/after" "$Q" run --label P2 -- sh -c 'touch "$0/P2-ran"' "$work" >/dev/null 2>&1 &
P2=$!
await_state "P2 @" running
g=$(supervisor_group)
kill -TERM "$P2"; wait "$P2"
[ ! -e "$work/P2-ran" ] && [ "$(group_members "$g")" = 0 ] \
  && pass "cancel after pid publication: group stopped, command never runs" || fail "race after pid" "ran or group alive"

# 8. Exclusive fairness: an ordinary job queued after a queued exclusive job waits for it.
"$Q" slots 2 >/dev/null
"$Q" run --label X -- sh -c 'sleep 2; date +%s.%N > "$0/X.end"' "$work" >/dev/null 2>&1 &
X=$!
await_state "X @" running
"$Q" run --label E --exclusive -- sh -c 'date +%s.%N > "$0/E.start"; sleep 1; date +%s.%N > "$0/E.end"' "$work" >/dev/null 2>&1 &
E=$!
await_state "E [exclusive] @" queued
"$Q" run --label Y -- sh -c 'date +%s.%N > "$0/Y.start"' "$work" >/dev/null 2>&1 &
Y=$!
wait "$X" "$E" "$Y"
if [ "$(cat "$work/E.start")" \> "$(cat "$work/X.end")" ] && [ "$(cat "$work/Y.start")" \> "$(cat "$work/E.end")" ]; then
  pass "exclusive runs alone after X; Y waits for it"
else
  fail "exclusive fairness" "X.end=$(cat "$work/X.end") E=$(cat "$work/E.start")..$(cat "$work/E.end") Y=$(cat "$work/Y.start")"
fi

# 8b. Arrival order. An ordinary job that waits for a queued exclusive job keeps
#     its place: an exclusive job that arrives after it must not run before it.
"$Q" slots 2 >/dev/null
"$Q" run --label F1 --exclusive -- sh -c 'sleep 3' >/dev/null 2>&1 &
F1=$!
await_state "F1 [exclusive] @" running
"$Q" run --label F2 --exclusive -- sh -c 'date +%s.%N > "$0/F2.start"; sleep 1' "$work" >/dev/null 2>&1 &
F2=$!
await_state "F2 [exclusive] @" queued
"$Q" run --label FO -- sh -c 'date +%s.%N > "$0/FO.start"; sleep 1' "$work" >/dev/null 2>"$work/FO.err" &
FO=$!
await_text "$work/FO.err" "waiting for exclusive job"
"$Q" run --label F3 --exclusive -- sh -c 'date +%s.%N > "$0/F3.start"' "$work" >/dev/null 2>&1 &
F3=$!
wait "$F1" "$F2" "$FO" "$F3"
if [ "$(cat "$work/F2.start")" \< "$(cat "$work/FO.start")" ] && [ "$(cat "$work/FO.start")" \< "$(cat "$work/F3.start")" ]; then
  pass "arrival order: a waiting ordinary job runs before an exclusive job that arrived after it"
else
  fail "arrival order" "F2=$(cat "$work/F2.start") FO=$(cat "$work/FO.start") F3=$(cat "$work/F3.start")"
fi
# 8c. Cancelling a run that waits for an exclusive job ends it at once and lets
#     the jobs behind it proceed; `slots` does not block on the waiting run.
"$Q" run --label G1 --exclusive -- sh -c 'sleep 6' >/dev/null 2>&1 &
G1=$!
await_state "G1 [exclusive] @" running
"$Q" run --label G2 --exclusive -- sh -c 'sleep 1' >/dev/null 2>&1 &
G2=$!
await_state "G2 [exclusive] @" queued
"$Q" run --label GO -- sh -c 'touch "$0/GO.ran"' "$work" >/dev/null 2>"$work/GO.err" &
GO=$!
await_text "$work/GO.err" "waiting for exclusive job"
"$Q" run --label G3 -- sh -c 'touch "$0/G3.ran"' "$work" >/dev/null 2>&1 &
G3=$!
started=$(date +%s)
slots_out=$("$Q" slots 3 2>&1); slots_code=$?
slots_elapsed=$(( $(date +%s) - started ))
cancel_started=$(date +%s)
kill -TERM "$GO"; wait "$GO"; codeGO=$?
cancel_elapsed=$(( $(date +%s) - cancel_started ))
wait "$G1" "$G2" "$G3"
[ "$slots_code" = 1 ] && [ "$slots_elapsed" -le 2 ] && [ "$codeGO" = 130 ] && [ "$cancel_elapsed" -le 2 ] && [ ! -e "$work/GO.ran" ] && [ -e "$work/G3.ran" ] \
  && pass "cancelling a waiting run exits 130 at once; slots refuses without blocking; the job behind it runs" \
  || fail "cancel while waiting" "slots=$slots_code (${slots_elapsed}s: $slots_out) cancel=$codeGO (${cancel_elapsed}s) GO.ran=$([ -e "$work/GO.ran" ] && echo yes || echo no) G3.ran=$([ -e "$work/G3.ran" ] && echo yes || echo no) err=$(cat "$work/GO.err")"

# 8d. The events log and audit: a run writes one start line (with the host load
#     average) and one end line; audit reports no overlap for jobs that ran one
#     after the other, and reports an overlap in a log that has one.
"$Q" slots 2 >/dev/null
rm -f "$BOTSTERQ_HOME/events.log"
"$Q" run --label AE --exclusive -- true >/dev/null 2>&1
"$Q" run --label AO -- true >/dev/null 2>&1
starts=$(grep -c "^start" "$BOTSTERQ_HOME/events.log"); ends=$(grep -c "^end" "$BOTSTERQ_HOME/events.log")
"$Q" audit >"$work/audit.out" 2>&1; codeAudit=$?
[ "$starts" = 2 ] && [ "$ends" = 2 ] && [ "$codeAudit" = 0 ] && grep -q "load=" "$BOTSTERQ_HOME/events.log" && grep -q "0 overlap" "$work/audit.out" \
  && pass "events log has a start and an end per job, with the load average; audit finds no overlap" \
  || fail "events log" "starts=$starts ends=$ends audit=$codeAudit out=$(cat "$work/audit.out")"
printf 'start\t100.0\tT1\t2\t1\tX\tload=1/1/1\nstart\t105.0\tT2\t1\t0\tY\tload=1/1/1\nend\t110.0\tT2\t1\t0\tY\t\nend\t120.0\tT1\t2\t1\tX\t\nstart\t130.0\tT3\t1\t0\tZ\tload=1/1/1\nend\t140.0\tT3\t1\t0\tZ\t\n' >"$BOTSTERQ_HOME/events.log"
"$Q" audit >"$work/audit.out" 2>&1; codeAudit=$?
[ "$codeAudit" = 1 ] && grep -q "OVERLAP exclusive job T1 (X) and job T2 (Y)" "$work/audit.out" && grep -q "1 overlap" "$work/audit.out" && ! grep -q "T3" "$work/audit.out" \
  && pass "audit reports the job that overlapped an exclusive job, and only that one (exit 1)" \
  || fail "audit overlap" "audit=$codeAudit out=$(cat "$work/audit.out")"

# 8e. Cancel before the admission lock is held. A run that waits for an
#     exclusive job holds the lock; a second ordinary run then waits at the
#     lock. Cancelling that second run exits 130 at once, its command never
#     starts, and it leaves no admission process or file behind.
lock_waiters() { ps -axo command= | grep -F -- "$BOTSTERQ_HOME/admission.lock" | grep -vc grep; }
"$Q" slots 2 >/dev/null
"$Q" run --label H1 --exclusive -- sh -c 'sleep 6' >/dev/null 2>&1 &
H1=$!
await_state "H1 [exclusive] @" running
"$Q" run --label H2 --exclusive -- sh -c 'sleep 1' >/dev/null 2>&1 &
H2=$!
await_state "H2 [exclusive] @" queued
"$Q" run --label HO1 -- sh -c 'touch "$0/HO1.ran"' "$work" >/dev/null 2>"$work/HO1.err" &
HO1=$!
await_text "$work/HO1.err" "waiting for exclusive job"
mkfifo "$work/ho2.announce"
BOTSTERQ_TEST_LOCK_ANNOUNCE="$work/ho2.announce" "$Q" run --label HO2 -- sh -c 'touch "$0/HO2.ran"' "$work" >/dev/null 2>"$work/HO2.err" &
HO2=$!
# The admission announces that it is about to block on the lock (an event, not a
# poll); the cancel then lands while it blocks or in the instant before.
read _ <"$work/ho2.announce"
cancel_started=$(date +%s)
kill -TERM "$HO2"; wait "$HO2"; codeHO2=$?
cancel_elapsed=$(( $(date +%s) - cancel_started ))
waiters_after=$(lock_waiters)
admit_files=$(ls "$BOTSTERQ_HOME"/run/"$HO2"-*.admit* 2>/dev/null | wc -l | tr -d ' ')
wait "$H1" "$H2" "$HO1"
[ "$codeHO2" = 130 ] && [ "$cancel_elapsed" -le 2 ] && [ "$waiters_after" = 1 ] && [ "$admit_files" = 0 ] \
  && [ ! -e "$work/HO2.ran" ] && [ -e "$work/HO1.ran" ] \
  && pass "cancelling a run that waits at the admission lock exits 130 at once, never starts, leaves nothing behind" \
  || fail "cancel at the lock" "cancel=$codeHO2 (${cancel_elapsed}s) lock_waiters=$waiters_after admit_files=$admit_files HO2.ran=$([ -e "$work/HO2.ran" ] && echo yes || echo no) HO1.ran=$([ -e "$work/HO1.ran" ] && echo yes || echo no) err=$(cat "$work/HO2.err")"
leftover=$(ls "$BOTSTERQ_HOME"/run/*.admit* 2>/dev/null | wc -l | tr -d ' ')
[ "$leftover" = 0 ] && pass "no admission file remains after the runs end" || fail "admission files" "$leftover left: $(ls "$BOTSTERQ_HOME"/run/*.admit* 2>/dev/null | tr '\n' ' ')"

# 8k. The two boundaries of the admission protocol, tested directly (the test
#     stops `run` at the exact point through a hold fifo and sends TERM there):
#     (1) after the run marked the admission as started, before the admission
#     process exists; (2) after the admission ended and was reaped, before the
#     run marked it over; (3) the admission process just forked, before it wrote
#     its pid file. Each: exit 130 at once, the command never starts or is gone,
#     no admission file, no lock waiter, no job.
boundary_check() {
  name=$1 code=$2 elapsed=$3 label=${4:-}
  # A run cancelled before its admission gave a job to the queue must not have
  # started a command, even for a moment: the events log has no start for it.
  started_events=0
  [ -z "$label" ] || started_events=$(awk -F'\t' -v l="$label" '$1 == "start" && $6 == l { n++ } END { print n + 0 }' "$BOTSTERQ_HOME/events.log" 2>/dev/null)
  files=$(ls "$BOTSTERQ_HOME"/run/*.admit* 2>/dev/null | wc -l | tr -d ' ')
  waiters=$(lock_waiters)
  i=0
  until [ "$(TS_SOCKET="$BOTSTERQ_HOME/queue.sock" ts -l | awk '$2 == "queued" || $2 == "running"' | wc -l | tr -d ' ')" = 0 ]; do
    i=$((i + 1)); [ "$i" -gt 200 ] && break
    # timer: deadline — bounded wait for the queue to drain.
    perl -e 'select(undef, undef, undef, 0.05)'
  done
  jobs=$(TS_SOCKET="$BOTSTERQ_HOME/queue.sock" ts -l | awk '$2 == "queued" || $2 == "running"' | wc -l | tr -d ' ')
  alive=no
  [ -f "$work/$name.pid" ] && kill -0 "$(cat "$work/$name.pid")" 2>/dev/null && alive=yes
  [ "$code" = 130 ] && [ "$elapsed" -le 2 ] && [ "$files" = 0 ] && [ "$waiters" = 0 ] && [ "$jobs" = 0 ] && [ "$alive" = no ] && [ "$started_events" = 0 ] \
    && pass "cancel at the boundary: $name (exit 130, no admission file, no lock waiter, no job, no live command, no start event)" \
    || fail "boundary $name" "exit=$code (${elapsed}s) files=$files waiters=$waiters jobs=$jobs live_command=$alive start_events=$started_events: $(ls "$BOTSTERQ_HOME"/run/*.admit* 2>/dev/null | tr '\n' ' ')"
}
"$Q" slots 2 >/dev/null
# (1) before the admission process exists
mkfifo "$work/b1.hold" "$work/b1.hold.reached"
BOTSTERQ_TEST_RUN_BEFORE_ADMISSION="$work/b1.hold" "$Q" run --label B1 -- sh -c 'echo $$ > "$0"; exec sleep 30' "$work/b1.pid" >/dev/null 2>&1 &
B1=$!
read _ <"$work/b1.hold.reached"
started=$(date +%s); kill -TERM "$B1"; wait "$B1"; code=$?; elapsed=$(( $(date +%s) - started ))
boundary_check b1 "$code" "$elapsed" B1
# (2) after the admission was reaped, before the run marked it over
mkfifo "$work/b2.hold" "$work/b2.hold.reached"
BOTSTERQ_TEST_RUN_AFTER_ADMISSION="$work/b2.hold" "$Q" run --label B2 -- sh -c 'echo $$ > "$0"; exec sleep 30' "$work/b2.pid" >/dev/null 2>&1 &
B2=$!
read _ <"$work/b2.hold.reached"
started=$(date +%s); kill -TERM "$B2"; wait "$B2"; code=$?; elapsed=$(( $(date +%s) - started ))
boundary_check b2 "$code" "$elapsed"
# (3) the admission process just forked, before its pid file
mkfifo "$work/b3.hold" "$work/b3.hold.reached"
BOTSTERQ_TEST_ADMISSION_HOLD="$work/b3.hold" "$Q" run --label B3 -- sh -c 'echo $$ > "$0"; exec sleep 30' "$work/b3.pid" >/dev/null 2>&1 &
B3=$!
read _ <"$work/b3.hold.reached"
started=$(date +%s)
kill -TERM "$B3"
# The run must wait for its admission process (it cannot know its state): while
# that process is held, the run stays alive.
# timer: deadline — a negative window: the run must not exit while the admission lives.
perl -e 'select(undef, undef, undef, 0.4)'
kill -0 "$B3" 2>/dev/null && b3_waited=yes || b3_waited=no
printf x >"$work/b3.hold"   # release the held admission process; it finds the marker
wait "$B3"; code=$?; elapsed=$(( $(date +%s) - started ))
[ "$b3_waited" = yes ] && pass "cancel at the boundary: b3 the run waits for its admission process" || fail "boundary b3 wait" "the run exited while its admission process was held"
boundary_check b3 "$code" "$elapsed" B3

# 8l. A run killed without a chance to cancel (SIGKILL) while its admission
#     waits at the lock: the cancel fifo reports end of file, the admission
#     cancels itself, and no admission process is left waiting at the lock.
"$Q" slots 2 >/dev/null
"$Q" run --label M1 --exclusive -- sh -c 'sleep 3' >/dev/null 2>&1 &
M1=$!
await_state "M1 [exclusive] @" running
"$Q" run --label M0 --exclusive -- sh -c 'sleep 0.5' >/dev/null 2>&1 &
M0=$!
await_state "M0 [exclusive] @" queued
"$Q" run --label MO -- sh -c 'touch "$0/MO.ran"' "$work" >/dev/null 2>"$work/MO.err" &
MO=$!
await_text "$work/MO.err" "waiting for exclusive job"
mkfifo "$work/mk.announce" "$work/mk.life"
BOTSTERQ_TEST_ADMISSION_LIFETIME="$work/mk.life" BOTSTERQ_TEST_LOCK_ANNOUNCE="$work/mk.announce" "$Q" run --label MK -- sh -c 'touch "$0/MK.ran"' "$work" >/dev/null 2>&1 &
MK=$!
exec 8<"$work/mk.life"        # opens once the admission process has opened its end
read _ <"$work/mk.announce"
kill -KILL "$MK"; wait "$MK" 2>/dev/null
# End of file on the lifetime fifo is the event that the admission process ended
# (it cancelled itself because its run died); no polling.
read _ <&8
exec 8<&-
waiters_killed=$(lock_waiters)
wait "$M1" "$M0" "$MO"
[ "$waiters_killed" = 1 ] && [ ! -e "$work/MK.ran" ] && [ -e "$work/MO.ran" ] \
  && pass "a run killed with SIGKILL while its admission waits at the lock: the admission cancels itself and its command never runs" \
  || fail "SIGKILLed run" "lock_waiters=$waiters_killed MK.ran=$([ -e "$work/MK.ran" ] && echo yes || echo no) MO.ran=$([ -e "$work/MO.ran" ] && echo yes || echo no)"

# 8f. Several waiters behind the holder start in the order they arrived. The
#     order among waiters at the lock is the kernel's flock wakeup order, which
#     is not a promise; this checks what the platform does, over three waiters.
"$Q" slots 1 >/dev/null
"$Q" run --label K1 --exclusive -- sh -c 'sleep 4' >/dev/null 2>&1 &
K1=$!
await_state "K1 [exclusive] @" running
"$Q" run --label K2 --exclusive -- sh -c 'sleep 1' >/dev/null 2>&1 &
K2=$!
await_state "K2 [exclusive] @" queued
for n in 1 2 3; do
  mkfifo "$work/kw$n.announce"
  BOTSTERQ_TEST_LOCK_ANNOUNCE="$work/kw$n.announce" "$Q" run --label "KW$n" -- sh -c 'date +%s.%N > "$0/KW'"$n"'.start"; sleep 0.3' "$work" >/dev/null 2>"$work/KW$n.err" &
  eval "KW$n=\$!"
  # KW1 takes the lock and waits for K2; KW2 and KW3 announce that they block.
  if [ "$n" = 1 ]; then await_text "$work/KW1.err" "waiting for exclusive job"; else read _ <"$work/kw$n.announce"; fi
done
wait "$K1" "$K2" "$KW1" "$KW2" "$KW3"
if [ "$(cat "$work/KW1.start")" \< "$(cat "$work/KW2.start")" ] && [ "$(cat "$work/KW2.start")" \< "$(cat "$work/KW3.start")" ]; then
  pass "three waiters behind the lock holder start in arrival order (platform behaviour, not a guarantee)"
else
  fail "waiter order" "1=$(cat "$work/KW1.start") 2=$(cat "$work/KW2.start") 3=$(cat "$work/KW3.start")"
fi

# 8g. Compatibility. The supervisor accepts the argument shape of a `run` that
#     started before the deadline existed (no run limit), and the legacy
#     `__admit` entry point still admits a job.
python3 "$here/botsterq-job" "$work/old.pid" "$work/old.marker" "$work/old.lock" "$$" 2 -- sh -c 'exit 3' >/dev/null 2>&1; codeOld=$?
[ "$codeOld" = 3 ] && pass "the supervisor accepts the old argument shape (no deadline), run status kept" || fail "old supervisor shape" "exit=$codeOld"
legacy_id=$(BOTSTERQ_OWNER=$$ "$Q" __admit legacy-token 0 legacy true 3>/dev/null 4>/dev/null </dev/null)
TS_SOCKET="$BOTSTERQ_HOME/queue.sock" ts -w "$legacy_id" >/dev/null 2>&1; codeLegacy=$?
case "$legacy_id" in ''|*[!0-9]*) legacy_ok=no ;; *) legacy_ok=yes ;; esac
[ "$legacy_ok" = yes ] && [ "$codeLegacy" = 0 ] && pass "the legacy __admit entry point admits a job (id $legacy_id, exit 0)" || fail "legacy admit" "id=$legacy_id exit=$codeLegacy"
rm -f "$work/old.pid" "$work/old.marker" "$work/old.lock" "$BOTSTERQ_HOME"/run/legacy-token.*

# 8h. Audit compares an open interval like a closed one (fractional seconds):
#     two jobs that are still running and started 0.1 s apart overlap.
printf 'start\t100.100\tO1\t2\t1\tX\tload=1/1/1\nstart\t100.200\tO2\t1\t0\tY\tload=1/1/1\n' >"$BOTSTERQ_HOME/events.log"
BOTSTERQ_AUDIT_NOW=100 "$Q" audit >"$work/audit.out" 2>&1; codeOpen=$?
BOTSTERQ_AUDIT_NOW=101 "$Q" audit >"$work/audit2.out" 2>&1; codeOpen2=$?
[ "$codeOpen2" = 1 ] && grep -q "OVERLAP exclusive job O1 (X) and job O2 (Y)" "$work/audit2.out" && grep -q "not proof" "$work/audit2.out" \
  && pass "audit: two open jobs that started 0.1 s apart overlap (exit 1); the output states its evidence limit" \
  || fail "audit open interval" "now=101: exit=$codeOpen2 out=$(cat "$work/audit2.out")"

# 8i. The same with the real clock: two jobs that are still running and started
#     a few milliseconds ago overlap (a clock truncated to whole seconds would
#     put both starts after "now" and report nothing).
now_s=$(perl -MTime::HiRes=time -e 'printf "%.3f %.3f", time - 0.05, time - 0.02')
set -- $now_s
printf 'start\t%s\tR1\t2\t1\tX\tload=1/1/1\nstart\t%s\tR2\t1\t0\tY\tload=1/1/1\n' "$1" "$2" >"$BOTSTERQ_HOME/events.log"
"$Q" audit >"$work/audit3.out" 2>&1; codeReal=$?
[ "$codeReal" = 1 ] && grep -q "OVERLAP exclusive job R1 (X) and job R2 (Y)" "$work/audit3.out" \
  && pass "audit with the real clock: two open jobs that just started overlap" \
  || fail "audit real clock" "exit=$codeReal out=$(cat "$work/audit3.out")"
rm -f "$BOTSTERQ_HOME/events.log"

# 8j. Cancel at every stage of admission. Runs are cancelled at increasing
#     delays after they start, so the signal lands while the run waits for the
#     lock, while the admission runs and after the job started. Each `run` ends;
#     a command that had started is gone (its pid is dead); no admission process
#     waits at the lock; no admission file is left; and the queue drains (a job
#     that was enqueued in the instant of the cancel is skipped at its start,
#     because its `run` is gone).
"$Q" slots 2 >/dev/null
j=0
while [ "$j" -lt 30 ]; do
  "$Q" run --label "J$j" -- sh -c 'echo $$ > "$0"; exec sleep 30' "$work/J$j.pid" >/dev/null 2>&1 &
  J=$!
  # timer: deadline — test-side delay that walks the cancel across the stages.
  perl -e 'select(undef, undef, undef, $ARGV[0])' "$(perl -e 'printf "%.3f", $ARGV[0] * 0.012' "$j")"
  kill -TERM "$J" 2>/dev/null
  wait "$J" 2>/dev/null
  j=$((j + 1))
done
i=0
until [ "$(TS_SOCKET="$BOTSTERQ_HOME/queue.sock" ts -l | awk '$2 == "queued" || $2 == "running"' | wc -l | tr -d ' ')" = 0 ]; do
  i=$((i + 1)); [ "$i" -gt 200 ] && break
  # timer: deadline — bounded wait for the queue to drain.
  perl -e 'select(undef, undef, undef, 0.05)'
done
left_jobs=$(TS_SOCKET="$BOTSTERQ_HOME/queue.sock" ts -l | awk '$2 == "queued" || $2 == "running"' | wc -l | tr -d ' ')
left_waiters=$(lock_waiters)
left_files=$(ls "$BOTSTERQ_HOME"/run/*.admit* 2>/dev/null | wc -l | tr -d ' ')
alive=0
for f in "$work"/J*.pid; do
  [ -f "$f" ] || continue
  kill -0 "$(cat "$f")" 2>/dev/null && alive=$((alive + 1))
done
[ "$left_waiters" = 0 ] && [ "$left_jobs" = 0 ] && [ "$alive" = 0 ] && [ "$left_files" = 0 ] \
  && pass "30 runs cancelled at increasing delays leave no lock waiter, no job, no live command and no admission file" \
  || fail "cancel at every stage" "lock_waiters=$left_waiters jobs=$left_jobs live_commands=$alive admission_files=$left_files: $(ls "$BOTSTERQ_HOME"/run/*.admit* 2>/dev/null | tr '\n' ' ')"

# 9. Nested run inside a job runs directly (no deadlock at one slot).
"$Q" slots 1 >/dev/null
out=$("$Q" run --label outer -- sh -c "$Q run --label inner -- echo inner-ran" 2>&1)
echo "$out" | grep -q inner-ran && pass "nested run executes directly" || fail "nested" "$out"

# 10. A queued job whose run process was SIGKILLed does not start.
"$Q" run --label H -- sh -c 'sleep 2' >/dev/null 2>&1 &
H=$!
await_state "H @" running
"$Q" run --label O -- sh -c 'touch "$0/O-ran"' "$work" >/dev/null 2>&1 &
O=$!
await_state "O @" queued
kill -KILL "$O"
wait "$H"
TS_SOCKET="$BOTSTERQ_HOME/queue.sock" ts -w >/dev/null 2>&1
[ ! -e "$work/O-ran" ] && pass "orphaned queued job does not start" || fail "orphan" "the command ran"

# 11. cancel <id> escalates like run's cancel.
"$Q" run --label C -- sh -c 'sh -c "trap \"\" TERM; sleep 60" & trap "exit 0" TERM; wait' >/dev/null 2>&1 &
C=$!
await_state "C @" running
id=$(TS_SOCKET="$BOTSTERQ_HOME/queue.sock" ts -l | awk 'index($0, "[C @ ") && $2 == "running" { print $1 }')
g=$(job_group)
"$Q" cancel "$id" >"$work/cancel.out" 2>&1; codeCancel=$?
wait "$C" 2>/dev/null
[ "$codeCancel" = 0 ] && [ "$(group_members "$g")" = 0 ] && pass "cancel <id> escalates to SIGKILL (cancel exit 0)" \
  || fail "cancel id" "cancel=$codeCancel group $g members=$(group_members "$g") out=$(cat "$work/cancel.out")"

# 12. Admission window: the job starts while its run process is still inside
#     admission (the id not yet stored); cancelling the run must stop it.
"$Q" slots 2 >/dev/null
mkfifo "$work/admit"
BOTSTERQ_TEST_ADMIT_HOLD="$work/admit" "$Q" run --label W -- sh -c 'touch "$0/W-started"; sleep 60' "$work" >/dev/null 2>"$work/W.err" &
W=$!
await_file "$work/W-started"
g=$(job_group)
kill -TERM "$W"
printf x >"$work/admit"
wait "$W"; codeW=$?
[ "$codeW" = 130 ] && [ -n "$g" ] && [ "$(group_members "$g")" = 0 ] \
  && pass "cancel during admission (job already started, id not yet stored) stops the job" \
  || fail "admission window" "run=$codeW group=$g members=$(group_members "$g") stderr=$(cat "$work/W.err")"

# 13. The slot is released only when the cancelled group is gone: the next
#     job must see no member of the cancelled job's group when it starts.
"$Q" slots 1 >/dev/null
"$Q" run --label K -- sh -c 'sh -c "trap \"\" TERM; sleep 60" & trap "exit 0" TERM; wait' >/dev/null 2>&1 &
K=$!
await_state "K @" running
g=$(job_group)
"$Q" run --label N -- sh -c 'ps -axo pgid= | awk -v g="$1" "\$1 == g" | wc -l | tr -d " " > "$0/N.seen"' "$work" "$g" >/dev/null 2>&1 &
N=$!
await_state "N @" queued
kill -TERM "$K"; wait "$K"
wait "$N"
[ "$(cat "$work/N.seen" 2>/dev/null)" = 0 ] \
  && pass "next job starts only after the cancelled group is empty" \
  || fail "slot release" "members of $g seen by the next job: $(cat "$work/N.seen" 2>/dev/null)"

# 14. A job that exits leaving a process in its group: the supervisor stops it
#     after the grace and warns, and the group is empty when run returns.
"$Q" run --label L -- sh -c 'sleep 60 & exit 0' >/dev/null 2>"$work/L.err"; codeL=$?
g=$(grep -o 'running: \[[0-9]*' "$work/L.err" | tr -dc 0-9)
[ "$codeL" = 0 ] && grep -q "left process(es) running: \[[0-9]*\]" "$work/L.err" && [ -z "$(ps -axo pid= | awk -v p="$g" '$1 == p')" ] \
  && pass "leftover process is stopped and reported; run keeps the command's status" \
  || fail "leftover" "run=$codeL stderr=$(cat "$work/L.err")"
# 14b. The same, in the order the census cannot see: the command has already
#      exited (a zombie, not a member) when the supervisor first waits, and its
#      leftover is still running. Its exit must still end the wait.
mkfifo "$work/L2.hold"
BOTSTERQ_TEST_AFTER_POLL="$work/L2.hold" "$Q" run --label L2 -- \
  sh -c 'sleep 60 & echo $! > "$0/L2.left"; exit 0' "$work" >/dev/null 2>"$work/L2.err" &
L2=$!
await_file "$work/L2.left"
g=$(job_group)
i=0
until ps -axo pgid=,stat= | awk -v g="$g" '$1 == g && $2 ~ /Z/' | grep -q .; do
  i=$((i + 1)); [ "$i" -gt 200 ] && break
  # timer: deadline — test-side wait for the command to become a zombie.
  perl -e 'select(undef, undef, undef, 0.05)'
done
started=$(date +%s)
echo go >"$work/L2.hold"
wait "$L2"; codeL2=$?
elapsed=$(( $(date +%s) - started ))
left=$(cat "$work/L2.left")
[ "$codeL2" = 0 ] && grep -q "left process(es) running: \[[0-9]*\]" "$work/L2.err" && [ "$elapsed" -le $((BOTSTERQ_KILL_GRACE + 5)) ] \
  && [ -z "$(ps -axo pid= | awk -v p="$left" '$1 == p')" ] \
  && pass "an exited command's leftover is reported even when the command exits first (${elapsed}s)" \
  || { fail "leftover after exit" "run=$codeL2 elapsed=${elapsed}s stderr=$(cat "$work/L2.err")"; kill "$left" 2>/dev/null; }

# 15. The direct command itself ignores SIGTERM: cancel must escalate to
#     SIGKILL at the grace deadline (bounded), with the documented statuses.
"$Q" slots 1 >/dev/null
"$Q" run --label T -- sh -c 'trap "" TERM; touch "$0/T-ready"; while :; do sleep 1; done' "$work" >/dev/null 2>"$work/T.err" &
T=$!
await_file "$work/T-ready"
g=$(job_group)
started=$(date +%s)
kill -TERM "$T"; wait "$T"; codeT=$?
elapsed=$(( $(date +%s) - started ))
[ "$codeT" = 130 ] && [ "$(group_members "$g")" = 0 ] && [ "$elapsed" -le $((BOTSTERQ_KILL_GRACE + 5)) ] \
  && pass "a TERM-ignoring direct command is SIGKILLed at the deadline (${elapsed}s, run exit 130)" \
  || fail "TERM-ignoring command" "run=$codeT elapsed=${elapsed}s group=$g members=$(group_members "$g") stderr=$(cat "$work/T.err")"
"$Q" run --label T2 -- sh -c 'trap "" TERM; touch "$0/T2-ready"; while :; do sleep 1; done' "$work" >/dev/null 2>&1 &
T2=$!
await_file "$work/T2-ready"
g=$(job_group)
id=$(TS_SOCKET="$BOTSTERQ_HOME/queue.sock" ts -l | awk 'index($0, "[T2 @ ") && $2 == "running" { print $1 }')
# At 1 slot, N2 waits behind T2; when it starts it records how many members of
# T2's group still exist, which must be 0 (the slot is held until cleanup).
"$Q" run --label N2 -- sh -c 'ps -axo pgid= | awk -v g="$1" "\$1 == g" | wc -l | tr -d " " > "$0/N2.seen"' "$work" "$g" >/dev/null 2>&1 &
N2=$!
await_state "N2 @" queued
"$Q" cancel "$id" >"$work/T2.cancel" 2>&1; codeT2=$?
wait "$T2"; runT2=$?
wait "$N2"
[ "$codeT2" = 0 ] && [ "$runT2" = 130 ] && [ "$(group_members "$g")" = 0 ] && [ "$(cat "$work/N2.seen" 2>/dev/null)" = 0 ] \
  && pass "cancel <id> of a TERM-ignoring direct command (cancel 0, run 130); the next job starts after cleanup" \
  || fail "cancel TERM-ignoring" "cancel=$codeT2 run=$runT2 members=$(group_members "$g") next-job-saw=$(cat "$work/N2.seen" 2>/dev/null) out=$(cat "$work/T2.cancel")"

# 16. Cancel after the supervisor installed its handlers but before it starts
#     the command: the command must never start.
mkfifo "$work/spawn"
BOTSTERQ_TEST_BEFORE_SPAWN="$work/spawn" "$Q" run --label S -- sh -c 'touch "$0/S-ran"' "$work" >/dev/null 2>"$work/S.err" &
S=$!
g=$(supervisor_group)
kill -TERM "$S"
# `run` prints "stopping job" once it has signalled the supervisor (which is
# held before spawning); only then is the hold released.
await_file "$work/S.err"
i=0
until grep -q "stopping job" "$work/S.err" 2>/dev/null; do
  i=$((i + 1)); [ "$i" -gt 200 ] && break
  # timer: deadline — test-side wait for run's cancel message.
  perl -e 'select(undef, undef, undef, 0.05)'
done
printf x >"$work/spawn"
wait "$S"; codeS=$?
[ "$codeS" = 130 ] && [ ! -e "$work/S-ran" ] && [ "$(group_members "$g")" = 0 ] \
  && pass "cancel before the command starts: it never starts (run exit 130)" \
  || fail "cancel before spawn" "run=$codeS ran=$( [ -e "$work/S-ran" ] && echo yes || echo no) stderr=$(cat "$work/S.err")"

# 17. Absence unproved keeps the slot. A job's command ignores SIGTERM and
#     BOTSTERQ_TEST_NO_SIGKILL stands in for a process that survives SIGKILL;
#     the variants also fail the ps census or the exit watch. A successor
#     queued at 1 slot must stay queued while the survivor lives, and start
#     only after the test kills the survivor (by its pid), seeing no member.
fault_case() {
  name=$1 expect=$2 ready=$3
  shift 3
  env "$@" "$Q" run --label "$name" -- \
    perl -e '$SIG{TERM} = "IGNORE"; open(my $f, ">", shift) or die; print $f "$$\n"; close $f; sleep 600' \
    "$work/$name.survivor" >/dev/null 2>"$work/$name.err" &
  runner=$!
  await_file "$work/$name.survivor"
  survivor=$(cat "$work/$name.survivor")
  # The group comes from the survivor itself, not the pid file: a supervisor
  # that failed would take its pid file with it.
  g=$(ps -o pgid= -p "$survivor" | tr -d ' ')
  "$Q" run --label "$name-next" -- sh -c 'ps -axo pgid= | awk -v g="$1" "\$1 == g" | wc -l | tr -d " " > "$0/next.seen"' \
    "$work" "$g" >/dev/null 2>&1 &
  next=$!
  await_state "$name-next @" queued
  kill -TERM "$runner"
  await_text "$work/$name.err" "$ready"
  # The successor must not start while the survivor lives: watch for it for
  # longer than the grace. Expected to time out.
  i=0 started_early=no
  while [ "$i" -lt 60 ]; do
    TS_SOCKET="$BOTSTERQ_HOME/queue.sock" ts -l | grep -F -- "$name-next @" | grep -q " running " && { started_early=yes; break; }
    i=$((i + 1))
    # timer: deadline — a negative window: the successor must stay queued.
    perl -e 'select(undef, undef, undef, 0.05)'
  done
  alive_before=$(kill -0 "$survivor" 2>/dev/null && echo yes || echo no)
  kill -KILL "$survivor" 2>/dev/null
  wait "$runner"; code=$?
  wait "$next"
  seen=$(cat "$work/next.seen" 2>/dev/null); rm -f "$work/next.seen"
  [ "$code" = 130 ] && [ "$started_early" = no ] && [ "$alive_before" = yes ] && [ "$seen" = 0 ] \
    && { [ -z "$expect" ] || grep -q -- "$expect" "$work/$name.err"; } \
    && pass "$name: the slot stays held while a SIGKILL survivor lives (run exit 130)" \
    || fail "$name" "run=$code started_early=$started_early survivor_alive=$alive_before next_saw=$seen stderr=$(cat "$work/$name.err")"
}
# The watch faults replace the real select functions (BOTSTERQ_TEST_FAIL_AT),
# so the supervisor's own conversion of each failure runs.
held="survived SIGKILL"
fault_case "survivor" "" "$held" BOTSTERQ_TEST_NO_SIGKILL=1
fault_case "survivor with failed census" "census failed" "$held" BOTSTERQ_TEST_NO_SIGKILL=1 BOTSTERQ_TEST_FAIL_CENSUS=1
fault_case "survivor with failed kqueue creation" "kqueue creation" "$held" BOTSTERQ_TEST_NO_SIGKILL=1 BOTSTERQ_TEST_FAIL_AT=kqueue
fault_case "survivor with failed registration" "registration failed" "$held" BOTSTERQ_TEST_NO_SIGKILL=1 BOTSTERQ_TEST_FAIL_AT=register
fault_case "survivor with failed wait" "wait failed" "$held" BOTSTERQ_TEST_NO_SIGKILL=1 BOTSTERQ_TEST_FAIL_AT=wait
fault_case "survivor with failed kqueue and fallback" "kqueue creation" "$held" BOTSTERQ_TEST_NO_SIGKILL=1 BOTSTERQ_TEST_FAIL_AT=kqueue,fallback
fault_case "survivor with a supervisor loop error" "supervisor error" "supervisor error" BOTSTERQ_TEST_NO_SIGKILL=1 BOTSTERQ_TEST_FAIL_AT=loop
fault_case "survivor with a failed pid-file publication" "supervisor error" "supervisor error" BOTSTERQ_TEST_NO_SIGKILL=1 BOTSTERQ_TEST_FAIL_AT=publish
fault_case "survivor with a failed diagnostic write" "" "" BOTSTERQ_TEST_NO_SIGKILL=1 BOTSTERQ_TEST_FAIL_AT=loop,diagnostic

# 18. A python3 older than 3.9 is refused before admission: nothing is queued.
mkdir -p "$work/oldpy"
cat >"$work/oldpy/python3" <<'OLDPY'
#!/bin/sh
[ "${1-}" = --version ] && { echo "Python 3.8.0"; exit 0; }
exit 1
OLDPY
chmod +x "$work/oldpy/python3"
before=$(TS_SOCKET="$BOTSTERQ_HOME/queue.sock" ts -l | wc -l | tr -d ' ')
PATH="$work/oldpy:$PATH" "$Q" run --label OLD -- true >/dev/null 2>"$work/old.err"; codeOld=$?
after=$(TS_SOCKET="$BOTSTERQ_HOME/queue.sock" ts -l | wc -l | tr -d ' ')
[ "$codeOld" = 127 ] && [ "$before" = "$after" ] && grep -q "3.9 or later" "$work/old.err" \
  && pass "a python3 older than 3.9 is refused before admission (run exit 127)" \
  || fail "old python" "run=$codeOld queued_before=$before after=$after stderr=$(cat "$work/old.err")"

# 19. Deadline. A hung command is stopped at expiry like a cancel: "deadline
#     expired", exit 124, no group member left, and the successor runs after
#     cleanup. An exclusive job has a default deadline (BOTSTERQ_EXCLUSIVE_DEADLINE
#     stands in for the 45 minutes); an ordinary job has none; a job that ends
#     first keeps its own status; a bad value is refused before admission.
"$Q" slots 1 >/dev/null
"$Q" run --label DL --deadline 3s -- sh -c 'trap "" TERM; touch "$0/DL-ready"; while :; do sleep 1; done' "$work" >/dev/null 2>"$work/DL.err" &
DL=$!
await_file "$work/DL-ready"
g=$(job_group)
"$Q" run --label DLnext -- sh -c 'ps -axo pgid= | awk -v g="$1" "\$1 == g" | wc -l | tr -d " " > "$0/DLnext.seen"' "$work" "$g" >/dev/null 2>&1 &
DLN=$!
await_state "DLnext @" queued
started=$(date +%s)
wait "$DL"; codeDL=$?
elapsed=$(( $(date +%s) - started ))
wait "$DLN"
[ "$codeDL" = 124 ] && grep -q "deadline expired" "$work/DL.err" && [ "$(group_members "$g")" = 0 ] \
  && [ "$(cat "$work/DLnext.seen" 2>/dev/null)" = 0 ] && [ "$elapsed" -le $((3 + BOTSTERQ_KILL_GRACE + 5)) ] \
  && pass "a hung command is stopped at its deadline (run exit 124, ${elapsed}s after the start of the wait); the successor runs after cleanup" \
  || fail "deadline" "run=$codeDL elapsed=${elapsed}s members=$(group_members "$g") next-saw=$(cat "$work/DLnext.seen" 2>/dev/null) stderr=$(cat "$work/DL.err")"
BOTSTERQ_EXCLUSIVE_DEADLINE=3 "$Q" run --label DLX --exclusive -- sh -c 'sleep 600' >/dev/null 2>"$work/DLX.err"; codeDLX=$?
[ "$codeDLX" = 124 ] && grep -q "deadline expired" "$work/DLX.err" \
  && pass "an exclusive job gets the default deadline (run exit 124)" \
  || fail "exclusive default deadline" "run=$codeDLX stderr=$(cat "$work/DLX.err")"
BOTSTERQ_EXCLUSIVE_DEADLINE=2 "$Q" run --label DLO -- sh -c 'sleep 5' >/dev/null 2>&1; codeDLO=$?
[ "$codeDLO" = 0 ] && pass "an ordinary job has no default deadline" || fail "ordinary job" "run=$codeDLO"
BOTSTERQ_EXCLUSIVE_DEADLINE=2 "$Q" run --label DLS --exclusive --deadline 60s -- sh -c 'sleep 4; exit 7' >/dev/null 2>&1; codeDLS=$?
[ "$codeDLS" = 7 ] && pass "an explicit deadline replaces the exclusive default, and a job that ends first keeps its status (7)" || fail "explicit deadline" "run=$codeDLS"
before=$(TS_SOCKET="$BOTSTERQ_HOME/queue.sock" ts -l | wc -l | tr -d ' ')
"$Q" run --label DLB --deadline 0 -- true >/dev/null 2>"$work/DLB.err"; codeDLB=$?
after=$(TS_SOCKET="$BOTSTERQ_HOME/queue.sock" ts -l | wc -l | tr -d ' ')
[ "$codeDLB" = 2 ] && [ "$before" = "$after" ] && pass "a bad deadline is refused before admission (run exit 2)" || fail "bad deadline" "run=$codeDLB before=$before after=$after"

# 19b. Target cap. A job whose directory is a cargo workspace with a target/
#     above the cap gets `cargo clean --target-dir target` there before its
#     command starts, and one line says so; under the cap, or with the cap off,
#     nothing happens; only that directory's ./target is ever cleaned (never
#     another worktree's, never a CARGO_TARGET_DIR, never a directory without
#     a Cargo.toml).
make_project() {
  mkdir -p "$1/src" "$1/target/debug"
  printf '[package]\nname = "capfixture"\nversion = "0.1.0"\nedition = "2021"\n' >"$1/Cargo.toml"
  : >"$1/src/lib.rs"
  dd if=/dev/zero of="$1/target/debug/big" bs=1048576 count=3 2>/dev/null
}
make_project "$work/capA"
make_project "$work/capB"
mkdir -p "$work/capC/target"; dd if=/dev/zero of="$work/capC/target/big" bs=1048576 count=3 2>/dev/null   # no Cargo.toml
"$Q" slots 2 >/dev/null
# under the cap: nothing happens
( cd "$work/capA" && BOTSTERQ_TARGET_CAP_GB=1 "$Q" run --label CapUnder -- sh -c 'test -e target/debug/big && echo kept' >"$work/capunder.out" 2>"$work/capunder.err" )
[ "$(cat "$work/capunder.out")" = kept ] && ! grep -q "cargo clean" "$work/capunder.err" \
  && pass "under the target cap: nothing is cleaned, no message" || fail "cap under" "out=$(cat "$work/capunder.out") err=$(cat "$work/capunder.err")"
# cap off (0): nothing happens
( cd "$work/capA" && BOTSTERQ_TARGET_CAP_GB=0 "$Q" run --label CapOff -- sh -c 'test -e target/debug/big && echo kept' >"$work/capoff.out" 2>&1 )
[ "$(cat "$work/capoff.out")" = kept ] && pass "a cap of 0 turns the clean off" || fail "cap off" "$(cat "$work/capoff.out")"
# CARGO_TARGET_DIR set: the command builds elsewhere; ./target is left alone
( cd "$work/capA" && CARGO_TARGET_DIR="$work/elsewhere" BOTSTERQ_TARGET_CAP_GB=0.001 "$Q" run --label CapEnv -- sh -c 'test -e target/debug/big && echo kept' >"$work/capenv.out" 2>&1 )
[ "$(cat "$work/capenv.out")" = kept ] && pass "with CARGO_TARGET_DIR set, ./target is not cleaned" || fail "cap env" "$(cat "$work/capenv.out")"
# no Cargo.toml: not a cargo workspace, nothing is cleaned
( cd "$work/capC" && BOTSTERQ_TARGET_CAP_GB=0.001 "$Q" run --label CapNoCargo -- sh -c 'test -e target/big && echo kept' >"$work/capnc.out" 2>&1 )
[ "$(cat "$work/capnc.out")" = kept ] && pass "a directory without Cargo.toml is not cleaned" || fail "cap no cargo" "$(cat "$work/capnc.out")"
# over the cap: cleaned before the command starts, one line, an event, and the
# other worktree is untouched
rm -f "$BOTSTERQ_HOME/events.log"
( cd "$work/capA" && BOTSTERQ_TARGET_CAP_GB=0.001 "$Q" run --label CapOver -- sh -c 'test -e target/debug/big && echo kept || echo cleaned' >"$work/capover.out" 2>"$work/capover.err" )
lines=$(grep -c "above the 0.001 GB cap" "$work/capover.err")
[ "$(cat "$work/capover.out")" = cleaned ] && [ "$lines" = 1 ] && [ -e "$work/capB/target/debug/big" ] && [ -e "$work/capC/target/big" ] \
  && grep -q "^clean	" "$BOTSTERQ_HOME/events.log" \
  && pass "over the target cap: cargo clean runs before the command, one message, an events line; other worktrees untouched" \
  || fail "cap over" "out=$(cat "$work/capover.out") lines=$lines B=$([ -e "$work/capB/target/debug/big" ] && echo kept || echo GONE) events=$(cat "$BOTSTERQ_HOME/events.log" 2>/dev/null | tr '\t' ' ')"

# 19c. A running job in the same directory protects the target. A long job is
#      running in a directory whose target is over the cap: a second job that
#      starts there must not clean it (the first job is using those artifacts);
#      it prints why and logs clean_skipped. Once the first job has ended, the
#      next job cleans.
make_project "$work/capD"
"$Q" slots 2 >/dev/null
rm -f "$BOTSTERQ_HOME/events.log"
( cd "$work/capD" && "$Q" run --label CapLong -- sh -c 'touch "$0/capd.long.up"; test -e target/debug/big && sleep 3; test -e target/debug/big && echo kept > "$0/capd.long.after"' "$work" >/dev/null 2>&1 ) &
CAPLONG=$!
await_file "$work/capd.long.up"
( cd "$work/capD" && BOTSTERQ_TARGET_CAP_GB=0.001 "$Q" run --label CapSecond -- sh -c 'test -e target/debug/big && echo kept' >"$work/capsecond.out" 2>"$work/capsecond.err" )
wait "$CAPLONG"
[ "$(cat "$work/capsecond.out")" = kept ] && [ "$(cat "$work/capd.long.after" 2>/dev/null)" = kept ] \
  && grep -q "cargo clean skipped: job(s) .* are running in this directory" "$work/capsecond.err" \
  && grep -q "^clean_skipped	" "$BOTSTERQ_HOME/events.log" \
  && pass "a running job in the same directory protects the target: the second job skips the clean, says why, and logs clean_skipped" \
  || fail "cap skipped for a running job" "second=$(cat "$work/capsecond.out") first_after=$(cat "$work/capd.long.after" 2>/dev/null) err=$(cat "$work/capsecond.err") events=$(tr '\t' ' ' <"$BOTSTERQ_HOME/events.log")"
( cd "$work/capD" && BOTSTERQ_TARGET_CAP_GB=0.001 "$Q" run --label CapThird -- sh -c 'test -e target/debug/big && echo kept || echo cleaned' >"$work/capthird.out" 2>&1 )
[ "$(tail -1 "$work/capthird.out")" = cleaned ] && pass "after that job ended, the next job over the cap cleans" || fail "cap after the long job" "$(cat "$work/capthird.out")"

# 19d. When the running-job list cannot be read the clean is skipped too, with
#      the reason, rather than guessing that nobody else is running.
make_project "$work/capE"
( cd "$work/capE" && BOTSTERQ_TEST_FAIL_JOB_LIST=1 BOTSTERQ_TARGET_CAP_GB=0.001 "$Q" run --label CapNoList -- sh -c 'test -e target/debug/big && echo kept || echo cleaned' >"$work/capnolist.out" 2>"$work/capnolist.err" )
[ "$(cat "$work/capnolist.out")" = kept ] && grep -q "cargo clean skipped: the running-job list cannot be read" "$work/capnolist.err" \
  && pass "an unreadable running-job list skips the clean and says so" || fail "cap without the job list" "out=$(cat "$work/capnolist.out") err=$(cat "$work/capnolist.err")"

# 20. A suite run leaves no supervisor behind. Jobs still finishing get a
#     bounded wait; any botsterq-job under this suite's home after that leaked.
leaked() { ps -axo pid=,command= | grep -F -- "botsterq-job $BOTSTERQ_HOME/" | grep -v grep; }
i=0
while [ "$i" -lt 100 ] && [ -n "$(leaked)" ]; do
  i=$((i + 1))
  # timer: deadline — bounded wait for the last supervisors to exit.
  perl -e 'select(undef, undef, undef, 0.1)'
done
leaks=$(leaked)
[ -z "$leaks" ] && pass "no botsterq-job supervisor survives the suite" \
  || fail "supervisor leak" "$leaks"

echo "failures: $failures"
[ "$failures" = 0 ]
