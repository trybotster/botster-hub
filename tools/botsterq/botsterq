#!/bin/sh
# botsterq: a machine-wide queue for heavy work (cargo builds, test suites).
#
#   botsterq run [--label <text>] [--exclusive] -- <command...>
#   botsterq list
#   botsterq cancel <id>
#   botsterq slots [N]
#
# Jobs run through task-spooler (`ts`, brew install task-spooler) on a
# dedicated socket, at most N at once (default 2). `run` blocks until its job
# has run, streams the job's output live, and exits with the job's exit code.
# The job runs in the caller's directory with the caller's environment, under
# `nice -n 10`, in its own process group. `--exclusive` makes the job take
# every slot, so it runs alone (use it for load-sensitive suites).
#
# Admission (enqueueing, and changing the slot count) is serialized by one
# lock, and `slots N` refuses while any job is queued or running, so an
# exclusive job's reservation always equals the slot count.
#
# Cancelling (Ctrl-C, SIGTERM or SIGHUP to `run`, or `botsterq cancel <id>`):
# a queued job never starts; a running job's process group gets SIGTERM, and
# SIGKILL if any member remains when the grace period ends. Only that job's
# group is signalled, never anything by name. A job whose `run` process is gone
# when its turn comes does not start. A caller killed with SIGKILL while its job
# runs cannot be noticed; `botsterq cancel <id>` stops such a job.
set -eu

state=${BOTSTERQ_HOME:-$HOME/.botsterq}
mkdir -p "$state/run"
export TS_SOCKET="$state/queue.sock"
default_slots=2
kill_grace_seconds=${BOTSTERQ_KILL_GRACE:-10}
# Resolve symlinks (~/.local/bin/botsterq links to the installed copy), so the
# job supervisor next to this script is found.
self=$(perl -MCwd=abs_path -e 'print abs_path(shift)' "$0")
supervisor="$(dirname "$self")/botsterq-job"

usage() {
  sed -n '3,7p' "$0" | sed 's/^# //' >&2
  exit 2
}

command -v ts >/dev/null 2>&1 || {
  echo "botsterq: task-spooler is missing; run: brew install task-spooler" >&2
  exit 127
}

configured_slots() {
  if [ -f "$state/slots" ]; then cat "$state/slots"; else echo "$default_slots"; fi
}

ensure_server() {
  TS_SLOTS=$(configured_slots) ts -l >/dev/null
}

# Runs "$@" while holding the admission lock (a perl flock; macOS has no
# flock(1)). The lock is released when the command exits.
with_admission_lock() {
  perl -MFcntl=:flock -e '
    open(my $lock, ">>", shift) or die "botsterq: open lock: $!\n";
    flock($lock, LOCK_EX) or die "botsterq: lock: $!\n";
    exit(system(@ARGV) >> 8);
  ' "$state/admission.lock" "$@"
}

active_jobs() {
  ts -l | awk '$2 == "queued" || $2 == "running"' | wc -l | tr -d ' '
}

# The pid file and cancel marker of job <token>.
job_paths() {
  pidfile="$state/run/$1.pid"
  marker="$state/run/$1.cancelled"
  joblock="$state/run/$1.lock"
}

token_of_job() {
  ts -l | awk -v id="$1" '$1 == id' | sed -n 's/^.* #\([0-9a-f-]*\)\].*$/\1/p'
}

group_alive() {
  kill -0 "-$1" 2>/dev/null
}

# Stop job <id> with token <token>. The marker comes first: a job that has not
# yet published its pid will see it and not start. A queued job is removed; a
# running job's group gets TERM, then KILL if any member outlives the grace.
# Returns 0 when the job cannot start and its group is empty.
stop_job() {
  id=$1
  job_paths "$2"
  # Under the job's lock: create the marker and read the pid file. The job
  # publishes its pid and checks the marker under the same lock, so exactly
  # one holds: the job published first (its supervisor is signalled here), or
  # the job will see the marker, delete it, and not start.
  # The pid file holds the supervisor's pid, then (once started) the command's
  # process group.
  published=$(perl -MFcntl=:flock -e '
    my ($lock, $marker, $pidfile) = @ARGV;
    open(my $l, ">>", $lock) or die "botsterq: open job lock: $!\n";
    flock($l, LOCK_EX) or die "botsterq: job lock: $!\n";
    open(my $m, ">", $marker) or die "botsterq: marker: $!\n";
    close($m);
    if (open(my $p, "<", $pidfile)) { chomp(my @ids = <$p>); print "@ids"; }
  ' "$joblock" "$marker" "$pidfile")
  supervisor_pid=${published%% *}
  command_group=
  case "$published" in *" "*) command_group=${published#* } ;; esac
  if [ -n "$id" ] && ts -r "$id" >/dev/null 2>&1; then
    rm -f "$marker"
    return 0
  fi
  [ -n "$supervisor_pid" ] || return 0
  rm -f "$marker"
  # The job's supervisor signals the command's group, SIGKILLs it when the
  # grace ends, and exits only when the kernel reports the group gone. So the
  # queue slot is released only after every member is gone, and its end
  # (ts -w) is the event that the group is gone.
  echo "botsterq: stopping job ${id:-?} (supervisor $supervisor_pid${command_group:+, process group $command_group})" >&2
  kill -TERM "$supervisor_pid" 2>/dev/null || true
  if [ -n "$id" ]; then
    ( ts -w "$id" >/dev/null 2>&1 ) &
    wait $! || true
  fi
  if [ -n "$command_group" ] && group_alive "$command_group"; then
    # Only reachable if the supervisor itself was killed.
    echo "botsterq: job ${id:-?} supervisor is gone but group $command_group remains; sending SIGKILL" >&2
    kill -KILL "-$command_group" 2>/dev/null || true
    return 1
  fi
  return 0
}

cmd_slots() {
  ensure_server
  if [ "$#" -eq 0 ]; then
    ts -S
    return
  fi
  case "$1" in
    ''|*[!0-9]*|0) echo "botsterq: slots must be a positive integer" >&2; exit 2 ;;
  esac
  with_admission_lock "$self" __set-slots "$1"
}

set_slots_locked() {
  active=$(active_jobs)
  if [ "$active" -ne 0 ]; then
    echo "botsterq: $active job(s) queued or running; change slots when the queue is empty" >&2
    exit 1
  fi
  printf '%s\n' "$1" >"$state/slots"
  ts -S "$1"
  echo "botsterq: $1 slots"
}

cmd_list() {
  ensure_server
  printf '%-5s %-8s %-9s %s\n' ID STATE ENQUEUED "LABEL @ OWNER"
  ts -l | awk '$2 == "queued" || $2 == "running" { print $1, $2 }' | while read -r id job_state; do
    label=$(ts -l | awk -v id="$id" '$1 == id' | sed -n 's/^[^[]*\[\(.*\) #[^]]*\].*$/\1/p')
    enqueued=$(ts -i "$id" 2>/dev/null | sed -n 's/^Enqueue time: [A-Za-z]* [A-Za-z]* *[0-9]* \([0-9:]*\) .*/\1/p')
    printf '%-5s %-8s %-9s %s\n' "$id" "$job_state" "${enqueued:-?}" "$label"
  done
}

cmd_cancel() {
  [ "$#" -eq 1 ] || usage
  ensure_server
  case $(ts -s "$1" 2>/dev/null) in
    queued|running) ;;
    *) echo "botsterq: job $1 is not queued or running" >&2; exit 1 ;;
  esac
  token=$(token_of_job "$1")
  [ -n "$token" ] || { echo "botsterq: job $1 is not a botsterq job" >&2; exit 1; }
  stop_job "$1" "$token"
}

# Under the admission lock: enqueue the job and print its id, or print
# "wait <id>" when an exclusive job is queued ahead of this ordinary job.
admit_locked() {
  token=$1 exclusive=$2 label=$3
  shift 3
  if [ "$exclusive" = 1 ]; then
    slots_needed=$(ts -S)
    marker_text=" [exclusive]"
  else
    slots_needed=1
    marker_text=
    # An exclusive job needs every slot at once; task-spooler would keep
    # filling single free slots from behind it, so ordinary jobs wait for it.
    queued_exclusive=$(ts -l | awk '$2 == "queued" && index($0, " [exclusive] @ ") { print $1; exit }')
    if [ -n "$queued_exclusive" ]; then
      echo "wait $queued_exclusive"
      return
    fi
  fi
  job_paths "$token"
  enqueued="$state/run/$token.enqueued"
  rm -f "$enqueued"
  mkfifo "$enqueued"
  # TS_ENV runs once ts has enqueued the job: its FIFO write is the event that
  # makes the job's id readable. The job publishes its pid, then starts only
  # if it was not cancelled and its `run` process still exists.
  TS_ENV="echo enqueued >'$enqueued'" ts -f -n -N "$slots_needed" -L "$label$marker_text @ $(pwd) #$token" \
    python3 "$supervisor" "$pidfile" "$marker" "$joblock" "$BOTSTERQ_OWNER" "$kill_grace_seconds" -- "$@" \
    </dev/null >&3 2>&4 &
  read _ <"$enqueued" || true
  rm -f "$enqueued"
  id=$(ts -l | awk -v token="#$token]" 'index($0, token) { print $1; exit }')
  [ -n "$id" ] || { echo "botsterq: enqueued job not found" >&2; exit 1; }
  [ -z "${BOTSTERQ_TEST_ADMIT_HOLD:-}" ] || read _ <"$BOTSTERQ_TEST_ADMIT_HOLD" || true
  echo "$id"
}

cmd_run() {
  label=job
  exclusive=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --label) [ "$#" -ge 2 ] || usage; label=$2; shift 2 ;;
      --exclusive) exclusive=1; shift ;;
      --) shift; break ;;
      *) usage ;;
    esac
  done
  [ "$#" -ge 1 ] || usage
  # Inside a botsterq job, run directly: queueing would wait for a slot this
  # job's own parent holds, which deadlocks when the slots are full.
  if [ -n "${BOTSTERQ_JOB:-}" ]; then
    exec "$@"
  fi
  # The job supervisor runs under this PATH's python3; it needs 3.9 or later.
  python3 -c 'import sys; sys.exit(sys.version_info < (3, 9))' 2>/dev/null || {
    echo "botsterq: the job supervisor needs python3 3.9 or later on PATH (found: $(python3 --version 2>&1 || echo none))" >&2
    exit 127
  }
  ensure_server
  token="$$-$(date +%s)-$(od -An -N4 -tx4 /dev/urandom | tr -d ' ')"
  export BOTSTERQ_OWNER=$$
  id=
  interrupted() {
    trap - INT TERM HUP
    status=130
    # The signal may arrive before the admitted id is stored; the token names
    # the job either way, so resolve its id and stop it.
    [ -n "$id" ] || id=$(ts -l | awk -v token="#$token]" 'index($0, token) { print $1; exit }')
    stop_job "$id" "$token" || status=1
    rm -f "$state/run/$token.pid" "$state/run/$token.lock" "$state/run/$token.enqueued"
    exit "$status"
  }
  trap interrupted INT TERM HUP
  # The job's output goes to the caller's stdout and stderr (fds 3 and 4),
  # not into the command substitution that reads the admitted id.
  exec 3>&1 4>&2
  while :; do
    admitted=$(with_admission_lock "$self" __admit "$token" "$exclusive" "$label" "$@")
    case "$admitted" in
      "wait "*)
        echo "botsterq: waiting for exclusive job ${admitted#wait } before queueing" >&2
        ( ts -w "${admitted#wait }" >/dev/null 2>&1 ) &
        wait $! || true
        ;;
      *) id=$admitted; break ;;
    esac
  done
  ( ts -w "$id" >/dev/null 2>&1 ) &
  waiter=$!
  status=0
  wait "$waiter" || status=$?
  rm -f "$state/run/$token.pid" "$state/run/$token.lock" "$state/run/$token.enqueued"
  exit "$status"
}

[ "$#" -ge 1 ] || usage
subcommand=$1
shift
case "$subcommand" in
  run) cmd_run "$@" ;;
  list) cmd_list ;;
  cancel) cmd_cancel "$@" ;;
  slots) cmd_slots "$@" ;;
  __admit) admit_locked "$@" ;;
  __set-slots) set_slots_locked "$@" ;;
  *) usage ;;
esac
